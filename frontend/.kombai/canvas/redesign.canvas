      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Bitter:wght@700&family=Cabin:wght@400;500;700&display=swap');\n\n  :root {\n    --k-color-primary: #DFFF00;\n    --k-color-surface: #2C2C2C;\n    --k-color-surface-card: #383838;\n    --k-color-surface-secondary: #1A1A1A;\n    --k-color-on-surface: #E0E0E0;\n    --k-color-on-surface-secondary: #A0A0A0;\n    --k-color-on-surface-muted: #666666;\n    --k-color-border: #444444;\n  }\n\n  body {\n    background-color: var(--k-color-surface);\n    color: var(--k-color-on-surface);\n    font-family: 'Cabin', sans-serif;\n    margin: 0;\n  }\n\n  .font-heading { font-family: 'Bitter', serif; }\n  \n  .lime-glow {\n    text-shadow: 0 0 20px rgba(223, 255, 0, 0.4);\n  }\n\n  .chunky-shadow {\n    box-shadow: 12px 12px 0 0 rgba(0, 0, 0, 0.8);\n  }\n\n  .wabi-radius {\n    border-radius: 40px 10px 45px 12px / 15px 40px 10px 45px;\n  }\n\n  .tilted-card {\n    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);\n  }\n  .tilted-card:hover {\n    transform: rotate(0deg) scale(1.02);\n    background-color: #444444;\n  }\n\n  .marching-ants {\n    background-image: linear-gradient(90deg, #DFFF00 50%, transparent 50%), linear-gradient(90deg, #DFFF00 50%, transparent 50%), linear-gradient(0deg, #DFFF00 50%, transparent 50%), linear-gradient(0deg, #DFFF00 50%, transparent 50%);\n    background-repeat: repeat-x, repeat-x, repeat-y, repeat-y;\n    background-size: 15px 2px, 15px 2px, 2px 15px, 2px 15px;\n    background-position: left top, right bottom, left bottom, right top;\n    animation: ants 10s infinite linear;\n  }\n\n  @keyframes ants {\n    0% { background-position: left top, right bottom, left bottom, right top; }\n    100% { background-position: left 200px top, right 200px bottom, left bottom 200px, right top 200px; }\n  }\n\n  .morph-blob {\n    width: 40px;\n    height: 40px;\n    background: var(--k-color-primary);\n    border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;\n    animation: morph 6s ease-in-out infinite alternate;\n    filter: blur(2px);\n  }\n\n  @keyframes morph {\n    0% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }\n    50% { border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%; }\n    100% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }\n  }\n\n  .crosshatch {\n    background-image: radial-gradient(#444 0.5px, transparent 0.5px);\n    background-size: 10px 10px;\n  }\n\n  .torn-edge {\n    clip-path: polygon(0% 0%, 5% 2%, 10% 0%, 15% 3%, 20% 0%, 25% 2%, 30% 0%, 35% 3%, 40% 0%, 45% 2%, 50% 0%, 55% 3%, 60% 0%, 65% 2%, 70% 0%, 75% 3%, 80% 0%, 85% 2%, 90% 0%, 95% 3%, 100% 0%, 100% 100%, 95% 97%, 90% 100%, 85% 97%, 80% 100%, 75% 97%, 70% 100%, 65% 97%, 60% 100%, 55% 97%, 50% 100%, 45% 97%, 40% 100%, 35% 97%, 30% 100%, 25% 97%, 20% 100%, 15% 97%, 10% 100%, 5% 97%, 0% 100%);\n  }\n\n  .scribble-underline::after {\n    content: '';\n    position: absolute;\n    bottom: -8px;\n    left: 0;\n    width: 100%;\n    height: 12px;\n    background: url('data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 200 12\" preserveAspectRatio=\"none\"><path d=\"M0,5 C50,0 150,10 200,5\" stroke=\"%23DFFF00\" stroke-width=\"3\" fill=\"none\"/></svg>');\n    background-size: 100% 100%;\n  }\n</style>\n\n<div class=\"flex min-h-screen\" data-kid=\"1\">\n  \n  <aside class=\"fixed left-0 top-0 h-full w-20 bg-[#1A1A1A] border-r border-[#444] flex flex-col items-center py-8 z-50\" data-kid=\"2\">\n    <div class=\"mb-12\" data-kid=\"3\">\n      <i class=\"ti ti-link text-[#DFFF00] text-3xl\" data-kid=\"4\"></i>\n    </div>\n    \n    <nav class=\"flex flex-col gap-8 relative\" data-kid=\"5\">\n      <div class=\"absolute -left-2 top-0 morph-blob opacity-40\" data-kid=\"6\"></div>\n      <a href=\"#\" class=\"relative z-10 text-[#DFFF00]\" data-kid=\"7\"><i class=\"ti ti-home-2 text-2xl\" data-kid=\"8\"></i></a>\n      <a href=\"#\" class=\"relative z-10 text-[#666] hover:text-[#E0E0E0]\" data-kid=\"9\"><i class=\"ti ti-chart-bar text-2xl\" data-kid=\"10\"></i></a>\n      <a href=\"#\" class=\"relative z-10 text-[#666] hover:text-[#E0E0E0]\" data-kid=\"11\"><i class=\"ti ti-info-circle text-2xl\" data-kid=\"12\"></i></a>\n      <a href=\"#\" class=\"relative z-10 text-[#666] hover:text-[#E0E0E0]\" data-kid=\"13\"><i class=\"ti ti-settings text-2xl\" data-kid=\"14\"></i></a>\n    </nav>\n  </aside>\n\n  \n  <main class=\"flex-1 ml-20 crosshatch\" data-kid=\"15\">\n    \n    <section class=\"pt-32 pb-24 px-12 relative overflow-hidden\" data-kid=\"16\">\n      <div class=\"max-w-4xl mx-auto text-center relative z-10\" data-kid=\"17\">\n        <span class=\"inline-block px-4 py-1 bg-[#1A1A1A] border border-[#DFFF00] text-[#DFFF00] text-xs font-bold tracking-widest uppercase mb-6 rounded-sm\" data-kid=\"18\">The Vision</span>\n        <h1 class=\"font-heading text-7xl text-[#E0E0E0] mb-8 lime-glow leading-tight relative inline-block\" data-kid=\"19\">\n          Redefining <span class=\"text-[#DFFF00]\" data-kid=\"20\">Links</span>\n          <div class=\"absolute -bottom-2 left-0 w-full h-4 bg-[#DFFF00]/10 -skew-x-12 -z-10\" data-kid=\"21\"></div>\n        </h1>\n        <p class=\"text-xl text-[#A0A0A0] leading-relaxed max-w-2xl mx-auto\" data-kid=\"22\">\n          We’re a moody team of nocturnals building tools for the modern web. Linklytics is more than a shortener; it's a sketchpad for your digital footprint.\n        </p>\n      </div>\n      \n      \n      <div class=\"absolute top-20 right-[-100px] w-96 h-96 bg-[#DFFF00]/5 rounded-full blur-3xl\" data-kid=\"23\"></div>\n      <div class=\"absolute bottom-10 left-[-100px] w-80 h-80 bg-[#DFFF00]/3 rounded-full blur-3xl\" data-kid=\"24\"></div>\n    </section>\n\n    \n    <section class=\"py-24 px-12 bg-[#1A1A1A]/50 border-y border-[#444]\" data-kid=\"25\">\n      <div class=\"max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8\" data-kid=\"26\">\n        <div class=\"tilted-card -rotate-1 bg-[#383838] p-8 border border-[#444] chunky-shadow\" data-kid=\"27\">\n          <div class=\"text-[#DFFF00] font-heading text-4xl mb-2\" data-kid=\"28\">10M+</div>\n          <div class=\"text-[#666] uppercase text-xs tracking-widest font-bold\" data-kid=\"29\">Links Shortened</div>\n        </div>\n        <div class=\"tilted-card rotate-1 bg-[#383838] p-8 border border-[#444] chunky-shadow\" data-kid=\"30\">\n          <div class=\"text-[#DFFF00] font-heading text-4xl mb-2\" data-kid=\"31\">50K+</div>\n          <div class=\"text-[#666] uppercase text-xs tracking-widest font-bold\" data-kid=\"32\">Active Sketchers</div>\n        </div>\n        <div class=\"tilted-card -rotate-1.5 bg-[#383838] p-8 border border-[#444] chunky-shadow\" data-kid=\"33\">\n          <div class=\"text-[#DFFF00] font-heading text-4xl mb-2\" data-kid=\"34\">180+</div>\n          <div class=\"text-[#666] uppercase text-xs tracking-widest font-bold\" data-kid=\"35\">Nations Inked</div>\n        </div>\n        <div class=\"tilted-card rotate-1.5 bg-[#383838] p-8 border border-[#444] chunky-shadow\" data-kid=\"36\">\n          <div class=\"text-[#DFFF00] font-heading text-4xl mb-2\" data-kid=\"37\">99.9%</div>\n          <div class=\"text-[#666] uppercase text-xs tracking-widest font-bold\" data-kid=\"38\">Nightly Uptime</div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"py-32 px-12\" data-kid=\"39\">\n      <div class=\"max-w-4xl mx-auto bg-[#E0E0E0] p-16 torn-edge relative\" data-kid=\"40\">\n        <div class=\"absolute top-4 right-4 text-[#1A1A1A] opacity-20\" data-kid=\"41\">\n          <i class=\"ti ti-quote text-6xl\" data-kid=\"42\"></i>\n        </div>\n        <h2 class=\"font-heading text-4xl text-[#1A1A1A] mb-8 relative inline-block scribble-underline\" data-kid=\"43\">\n          The Mission\n        </h2>\n        <p class=\"text-2xl text-[#1A1A1A] font-medium leading-relaxed italic\" data-kid=\"44\">\n          \"We believe in making link management imperfectly beautiful and accessible for everyone. Our nocturnal mission is to provide a reliable, secure, and sketching-first platform for the digital landscape.\"\n        </p>\n        <div class=\"mt-12 flex items-center gap-4\" data-kid=\"45\">\n          <div class=\"w-12 h-12 rounded-full bg-[#383838]\" data-kid=\"46\"></div>\n          <div data-kid=\"47\">\n            <div class=\"text-[#1A1A1A] font-bold\" data-kid=\"48\">A. Sketchwell</div>\n            <div class=\"text-[#666] text-sm uppercase\" data-kid=\"49\">Lead Architect</div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"py-24 px-12 bg-[#1A1A1A]\" data-kid=\"50\">\n      <div class=\"max-w-6xl mx-auto\" data-kid=\"51\">\n        <h2 class=\"font-heading text-5xl text-[#E0E0E0] mb-20 text-center lime-glow\" data-kid=\"52\">Why Choose Us?</h2>\n        \n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-16\" data-kid=\"53\">\n          <div class=\"flex gap-8 group\" data-kid=\"54\">\n            <div class=\"flex-shrink-0 w-16 h-16 bg-[#383838] border border-[#444] flex items-center justify-center chunky-shadow group-hover:-translate-y-2 transition-transform\" data-kid=\"55\">\n              <i class=\"ti ti-link text-[#DFFF00] text-3xl\" data-kid=\"56\"></i>\n            </div>\n            <div data-kid=\"57\">\n              <h3 class=\"font-heading text-2xl text-[#E0E0E0] mb-4\" data-kid=\"58\">Simple URL Shortening</h3>\n              <p class=\"text-[#A0A0A0] leading-relaxed\" data-kid=\"59\">Experience the ease of creating short, memorable URLs in just a few clicks. Intuitive and quick.</p>\n            </div>\n          </div>\n\n          <div class=\"flex gap-8 group\" data-kid=\"60\">\n            <div class=\"flex-shrink-0 w-16 h-16 bg-[#383838] border border-[#444] flex items-center justify-center chunky-shadow group-hover:-translate-y-2 transition-transform\" data-kid=\"61\">\n              <i class=\"ti ti-chart-dots text-[#DFFF00] text-3xl\" data-kid=\"62\"></i>\n            </div>\n            <div data-kid=\"63\">\n              <h3 class=\"font-heading text-2xl text-[#E0E0E0] mb-4\" data-kid=\"64\">Powerful Analytics</h3>\n              <p class=\"text-[#A0A0A0] leading-relaxed\" data-kid=\"65\">Gain insights into your link performance with our comprehensive nocturnal analytics dashboard.</p>\n            </div>\n          </div>\n\n          <div class=\"flex gap-8 group\" data-kid=\"66\">\n            <div class=\"flex-shrink-0 w-16 h-16 bg-[#383838] border border-[#444] flex items-center justify-center chunky-shadow group-hover:-translate-y-2 transition-transform\" data-kid=\"67\">\n              <i class=\"ti ti-shield-lock text-[#DFFF00] text-3xl\" data-kid=\"68\"></i>\n            </div>\n            <div data-kid=\"69\">\n              <h3 class=\"font-heading text-2xl text-[#E0E0E0] mb-4\" data-kid=\"70\">Enhanced Security</h3>\n              <p class=\"text-[#A0A0A0] leading-relaxed\" data-kid=\"71\">Rest assured with our robust security measures. All shortened URLs are protected with encryption.</p>\n            </div>\n          </div>\n\n          <div class=\"flex gap-8 group\" data-kid=\"72\">\n            <div class=\"flex-shrink-0 w-16 h-16 bg-[#383838] border border-[#444] flex items-center justify-center chunky-shadow group-hover:-translate-y-2 transition-transform\" data-kid=\"73\">\n              <i class=\"ti ti-bolt text-[#DFFF00] text-3xl\" data-kid=\"74\"></i>\n            </div>\n            <div data-kid=\"75\">\n              <h3 class=\"font-heading text-2xl text-[#E0E0E0] mb-4\" data-kid=\"76\">Fast and Reliable</h3>\n              <p class=\"text-[#A0A0A0] leading-relaxed\" data-kid=\"77\">Enjoy lightning-fast redirects and high uptime with our reliable charcoal-powered infrastructure.</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <footer class=\"py-20 px-12 flex justify-center\" data-kid=\"78\">\n      <div class=\"bg-[#111] px-8 py-4 rounded-full border border-[#444] flex items-center gap-12 chunky-shadow shadow-black/80\" data-kid=\"79\">\n        <div class=\"flex items-center gap-2\" data-kid=\"80\">\n          <div class=\"w-3 h-3 rounded-full bg-[#DFFF00] animate-pulse\" data-kid=\"81\"></div>\n          <span class=\"text-[#666] font-bold text-xs uppercase tracking-widest\" data-kid=\"82\">Live Status</span>\n        </div>\n        \n        <nav class=\"flex gap-8 text-[#E0E0E0] text-sm font-bold\" data-kid=\"83\">\n          <a href=\"#\" class=\"hover:text-[#DFFF00] transition-colors\" data-kid=\"84\">Privacy</a>\n          <a href=\"#\" class=\"hover:text-[#DFFF00] transition-colors\" data-kid=\"85\">Terms</a>\n          <a href=\"#\" class=\"hover:text-[#DFFF00] transition-colors\" data-kid=\"86\">API</a>\n        </nav>\n\n        <div class=\"text-[#666] text-xs font-bold uppercase tracking-widest border-l border-[#444] pl-12\" data-kid=\"87\">\n          v1.2.0-Alpha\n        </div>\n      </div>\n    </footer>\n  </main>\n</div>\n\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css\" data-kid=\"88\">",
