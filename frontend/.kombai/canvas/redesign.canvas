      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Bitter:wght@700&family=Cabin:wght@400;500;700&display=swap');\n\n  :root {\n    --k-color-primary: #DFFF00;\n    --k-color-primary-hover: #EFFF33;\n    --k-color-on-primary: #000000;\n    --k-color-accent: #DFFF00;\n    --k-color-surface: #2C2C2C;\n    --k-color-surface-card: #383838;\n    --k-color-surface-card-hover: #444444;\n    --k-color-surface-secondary: #1A1A1A;\n    --k-color-on-surface: #E0E0E0;\n    --k-color-on-surface-secondary: #A0A0A0;\n    --k-color-on-surface-muted: #666666;\n    --k-color-border: #444444;\n    --k-color-border-hover: #555555;\n    \n    --k-font-family-heading: 'Bitter', serif;\n    --k-font-family-body: 'Cabin', sans-serif;\n    \n    --k-radius-sm: 2px;\n    --k-radius-md: 4px;\n    --k-radius-lg: 8px;\n    --k-radius-xl: 12px;\n    --k-radius-wabi: 40px 10px 45px 12px / 15px 40px 10px 45px;\n  }\n\n  .font-heading { font-family: var(--k-font-family-heading); }\n  .font-body { font-family: var(--k-font-family-body); }\n\n  .lime-glow {\n    text-shadow: 0 0 15px rgba(223, 255, 0, 0.4);\n  }\n\n  .marching-ants {\n    background-image: linear-gradient(90deg, #fff 50%, transparent 50%), linear-gradient(90deg, #fff 50%, transparent 50%), linear-gradient(0deg, #fff 50%, transparent 50%), linear-gradient(0deg, #fff 50%, transparent 50%);\n    background-repeat: repeat-x, repeat-x, repeat-y, repeat-y;\n    background-size: 10px 1px, 10px 1px, 1px 10px, 1px 10px;\n    background-position: 0 0, 0 100%, 0 0, 100% 0;\n    animation: ants 10s linear infinite;\n  }\n\n  @keyframes ants {\n    to { background-position: 100% 0, -100% 100%, 0 -100%, 100% 100%; }\n  }\n\n  .morph-blob {\n    animation: morph 6s ease-in-out infinite alternate;\n  }\n\n  @keyframes morph {\n    0% { border-radius: 40% 60% 60% 40% / 60% 30% 70% 40%; }\n    100% { border-radius: 60% 40% 40% 60% / 30% 60% 40% 70%; }\n  }\n\n  .tilt-card {\n    transition: transform 0.3s ease, background-color 0.3s ease;\n  }\n  .tilt-card:hover {\n    transform: rotate(0deg) scale(1.02);\n    background-color: var(--k-color-surface-card-hover);\n  }\n\n  .btn-marching:hover .bg-fill {\n    height: 100%;\n  }\n\n  .crosshatch {\n    background-image: radial-gradient(circle, #444 1px, transparent 1px);\n    background-size: 10px 10px;\n  }\n</style>\n\n<div class=\"flex min-h-[900px] bg-[var(--k-color-surface)] font-body text-[var(--k-color-on-surface)] selection:bg-[var(--k-color-primary)] selection:text-black\" data-kid=\"1\">\n  \n  \n  <aside class=\"fixed left-0 top-0 bottom-0 w-20 bg-[var(--k-color-surface-secondary)] flex flex-col items-center py-8 z-50 border-r border-white/5\" data-kid=\"2\">\n    <div class=\"mb-12 relative\" data-kid=\"3\">\n      <div class=\"w-10 h-10 bg-[var(--k-color-primary)] rounded-lg flex items-center justify-center shadow-[4px_4px_0_rgba(0,0,0,1)]\" data-kid=\"4\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-6 h-6 text-black\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"5\"><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\" data-kid=\"6\"></path><path d=\"M12 21a9 9 0 1 1 0 -18a9 9 0 0 1 0 18z\" data-kid=\"7\"></path><path d=\"M12 7v10\" data-kid=\"8\"></path><path d=\"M7 12h10\" data-kid=\"9\"></path></svg>\n      </div>\n    </div>\n    \n    <nav class=\"flex flex-col gap-8 flex-1\" data-kid=\"10\">\n      <div class=\"relative group cursor-pointer\" data-kid=\"11\">\n        <div class=\"absolute -inset-2 bg-[var(--k-color-primary)] morph-blob opacity-100 scale-110 z-0\" data-kid=\"12\"></div>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-6 h-6 text-black relative z-10\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"13\"><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\" data-kid=\"14\"></path><path d=\"M5 12l-2 0l9 -9l9 9l-2 0\" data-kid=\"15\"></path><path d=\"M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7\" data-kid=\"16\"></path><path d=\"M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6\" data-kid=\"17\"></path></svg>\n      </div>\n      <div class=\"relative group cursor-pointer\" data-kid=\"18\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-6 h-6 text-[var(--k-color-on-surface-muted)] group-hover:text-[var(--k-color-primary)] transition-colors\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"19\"><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\" data-kid=\"20\"></path><path d=\"M3 3v18h18\" data-kid=\"21\"></path><path d=\"M20 18v3\" data-kid=\"22\"></path><path d=\"M16 16v5\" data-kid=\"23\"></path><path d=\"M12 13v8\" data-kid=\"24\"></path><path d=\"M8 16v5\" data-kid=\"25\"></path><path d=\"M3 11c6 0 5 -5 9 -5s3 5 9 5\" data-kid=\"26\"></path></svg>\n      </div>\n      <div class=\"relative group cursor-pointer\" data-kid=\"27\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-6 h-6 text-[var(--k-color-on-surface-muted)] group-hover:text-[var(--k-color-primary)] transition-colors\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"28\"><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\" data-kid=\"29\"></path><path d=\"M10 14a3.5 3.5 0 0 0 5 0l4 -4a3.5 3.5 0 0 0 -5 -5l-.5 .5\" data-kid=\"30\"></path><path d=\"M14 10a3.5 3.5 0 0 0 -5 0l-4 4a3.5 3.5 0 0 0 5 5l.5 -.5\" data-kid=\"31\"></path></svg>\n      </div>\n    </nav>\n\n    <div class=\"mt-auto\" data-kid=\"32\">\n      <div class=\"w-10 h-10 rounded-full border border-white/10 p-0.5\" data-kid=\"33\">\n        <img src=\"https://i.pravatar.cc/100?u=dashboard\" class=\"w-full h-full rounded-full grayscale hover:grayscale-0 transition-all cursor-pointer\" alt=\"User\" data-kid=\"34\">\n      </div>\n    </div>\n  </aside>\n\n  \n  <main class=\"ml-20 flex-1 p-12 relative overflow-hidden\" data-kid=\"35\">\n    \n    <div class=\"absolute inset-0 crosshatch opacity-[0.03] pointer-events-none\" data-kid=\"36\"></div>\n\n    <header class=\"flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-16 relative z-10\" data-kid=\"37\">\n      <div data-kid=\"38\">\n        <h1 class=\"font-heading text-6xl text-[var(--k-color-on-surface)] lime-glow mb-2\" data-kid=\"39\">Dashboard</h1>\n        <p class=\"text-[var(--k-color-on-surface-secondary)] text-lg\" data-kid=\"40\">Your nocturnal link command center.</p>\n      </div>\n      \n      <button class=\"btn-marching relative px-8 py-4 bg-[var(--k-color-surface-card)] text-[var(--k-color-primary)] font-bold uppercase tracking-widest text-xs border border-white/10 group overflow-hidden transition-all shadow-[4px_4px_0_rgba(0,0,0,1)] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[6px_6px_0_rgba(0,0,0,1)]\" data-kid=\"41\">\n        <div class=\"absolute inset-0 marching-ants opacity-30\" data-kid=\"42\"></div>\n        <div class=\"absolute bottom-0 left-0 w-full h-0 bg-[var(--k-color-primary)] transition-all duration-300 z-0 bg-fill\" data-kid=\"43\"></div>\n        <span class=\"relative z-10 group-hover:text-black transition-colors flex items-center gap-2\" data-kid=\"44\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4\" viewBox=\"0 0 24 24\" stroke-width=\"3\" stroke=\"currentColor\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"45\"><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\" data-kid=\"46\"></path><path d=\"M12 5l0 14\" data-kid=\"47\"></path><path d=\"M5 12l14 0\" data-kid=\"48\"></path></svg>\n          Create New Link\n        </span>\n      </button>\n    </header>\n\n    \n    <section class=\"grid grid-cols-1 md:grid-cols-3 gap-8 mb-16 relative z-10\" data-kid=\"49\">\n      \n      <div class=\"tilt-card bg-[var(--k-color-surface-card)] p-8 rounded-[var(--k-radius-md)] border border-white/5 shadow-[8px_8px_0_rgba(0,0,0,1)] -rotate-1\" data-kid=\"50\">\n        <div class=\"flex items-center justify-between mb-4\" data-kid=\"51\">\n          <span class=\"uppercase text-[var(--k-color-on-surface-muted)] text-[10px] font-bold tracking-[0.2em]\" data-kid=\"52\">Total Links</span>\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5 text-[var(--k-color-primary)]\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"53\"><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\" data-kid=\"54\"></path><path d=\"M10 14a3.5 3.5 0 0 0 5 0l4 -4a3.5 3.5 0 0 0 -5 -5l-.5 .5\" data-kid=\"55\"></path><path d=\"M14 10a3.5 3.5 0 0 0 -5 0l-4 4a3.5 3.5 0 0 0 5 5l.5 -.5\" data-kid=\"56\"></path></svg>\n        </div>\n        <div class=\"text-5xl font-heading text-[var(--k-color-on-surface)]\" data-kid=\"57\">24</div>\n        <div class=\"mt-4 h-1 w-12 bg-[var(--k-color-primary)]\" data-kid=\"58\"></div>\n      </div>\n\n      \n      <div class=\"tilt-card bg-[var(--k-color-surface-card)] p-8 rounded-[var(--k-radius-md)] border border-white/5 shadow-[8px_8px_0_rgba(0,0,0,1)] rotate-1\" data-kid=\"59\">\n        <div class=\"flex items-center justify-between mb-4\" data-kid=\"60\">\n          <span class=\"uppercase text-[var(--k-color-on-surface-muted)] text-[10px] font-bold tracking-[0.2em]\" data-kid=\"61\">Total Clicks</span>\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5 text-[var(--k-color-primary)]\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"62\"><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\" data-kid=\"63\"></path><path d=\"M6 19m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\" data-kid=\"64\"></path><path d=\"M18 19m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\" data-kid=\"65\"></path><path d=\"M12 5m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\" data-kid=\"66\"></path><path d=\"M6 19l6 -14l6 14\" data-kid=\"67\"></path></svg>\n        </div>\n        <div class=\"text-5xl font-heading text-[var(--k-color-on-surface)]\" data-kid=\"68\">1,842</div>\n        <div class=\"mt-4 flex gap-1\" data-kid=\"69\">\n          <div class=\"w-1.5 h-1.5 rounded-full bg-[var(--k-color-primary)] animate-pulse\" data-kid=\"70\"></div>\n          <span class=\"text-[10px] text-[var(--k-color-primary)] font-bold\" data-kid=\"71\">+12% vs last week</span>\n        </div>\n      </div>\n\n      \n      <div class=\"tilt-card bg-[var(--k-color-surface-card)] p-8 rounded-[var(--k-radius-md)] border border-white/5 shadow-[8px_8px_0_rgba(0,0,0,1)] -rotate-0.5\" data-kid=\"72\">\n        <div class=\"flex items-center justify-between mb-4\" data-kid=\"73\">\n          <span class=\"uppercase text-[var(--k-color-on-surface-muted)] text-[10px] font-bold tracking-[0.2em]\" data-kid=\"74\">Avg. Link Health</span>\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5 text-[var(--k-color-primary)]\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"75\"><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\" data-kid=\"76\"></path><path d=\"M3 12h4l3 8l4 -16l3 8h4\" data-kid=\"77\"></path></svg>\n        </div>\n        <div class=\"text-5xl font-heading text-[var(--k-color-on-surface)]\" data-kid=\"78\">76.8</div>\n        <div class=\"mt-4 h-1 w-full bg-[#444] rounded-full overflow-hidden\" data-kid=\"79\">\n          <div class=\"h-full bg-[var(--k-color-primary)] w-3/4\" data-kid=\"80\"></div>\n        </div>\n      </div>\n    </section>\n\n    \n    <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-8 relative z-10\" data-kid=\"81\">\n      \n      <div class=\"lg:col-span-2 bg-[var(--k-color-surface-card)] p-8 rounded-[var(--k-radius-lg)] border border-white/5 shadow-[12px_12px_0_rgba(0,0,0,1)]\" data-kid=\"82\">\n        <div class=\"flex items-center justify-between mb-8\" data-kid=\"83\">\n          <h2 class=\"font-heading text-3xl\" data-kid=\"84\">Click Analytics</h2>\n          <div class=\"flex gap-2\" data-kid=\"85\">\n            <span class=\"px-3 py-1 bg-[var(--k-color-surface-secondary)] text-[10px] font-bold uppercase tracking-widest text-[var(--k-color-on-surface-muted)] border border-white/5\" data-kid=\"86\">7 Days</span>\n            <span class=\"px-3 py-1 bg-[var(--k-color-primary)] text-[10px] font-bold uppercase tracking-widest text-black border border-black/10\" data-kid=\"87\">30 Days</span>\n          </div>\n        </div>\n        \n        <div class=\"h-72 w-full relative\" data-kid=\"88\">\n          <canvas id=\"analyticsChart\" data-kid=\"89\"></canvas>\n        </div>\n      </div>\n\n      \n      <div class=\"bg-[var(--k-color-surface-secondary)] p-8 rounded-[var(--k-radius-lg)] border border-white/5 shadow-[12px_12px_0_rgba(0,0,0,1)] relative overflow-hidden\" data-kid=\"90\">\n        <div class=\"absolute top-0 right-0 w-24 h-24 crosshatch opacity-10\" data-kid=\"91\"></div>\n        <h2 class=\"font-heading text-2xl mb-8\" data-kid=\"92\">Recent Inks</h2>\n        \n        <div class=\"space-y-6\" data-kid=\"93\">\n          <div class=\"group cursor-pointer\" data-kid=\"94\">\n            <div class=\"flex justify-between items-start mb-1\" data-kid=\"95\">\n              <span class=\"text-sm font-bold group-hover:text-[var(--k-color-primary)] transition-colors\" data-kid=\"96\">bit.ly/summer-sketch</span>\n              <span class=\"text-xs text-[var(--k-color-on-surface-muted)]\" data-kid=\"97\">248</span>\n            </div>\n            <p class=\"text-[10px] text-[var(--k-color-on-surface-muted)] truncate italic\" data-kid=\"98\">\"Portfolio 2024 Showcase\"</p>\n          </div>\n          \n          <div class=\"group cursor-pointer\" data-kid=\"99\">\n            <div class=\"flex justify-between items-start mb-1\" data-kid=\"100\">\n              <span class=\"text-sm font-bold group-hover:text-[var(--k-color-primary)] transition-colors\" data-kid=\"101\">bit.ly/midnight-coffee</span>\n              <span class=\"text-xs text-[var(--k-color-on-surface-muted)]\" data-kid=\"102\">1.2k</span>\n            </div>\n            <p class=\"text-[10px] text-[var(--k-color-on-surface-muted)] truncate italic\" data-kid=\"103\">\"Night Shift Playlist\"</p>\n          </div>\n\n          <div class=\"group cursor-pointer\" data-kid=\"104\">\n            <div class=\"flex justify-between items-start mb-1\" data-kid=\"105\">\n              <span class=\"text-sm font-bold group-hover:text-[var(--k-color-primary)] transition-colors\" data-kid=\"106\">bit.ly/wabi-textures</span>\n              <span class=\"text-xs text-[var(--k-color-on-surface-muted)]\" data-kid=\"107\">89</span>\n            </div>\n            <p class=\"text-[10px] text-[var(--k-color-on-surface-muted)] truncate italic\" data-kid=\"108\">\"Brutalist UI Assets\"</p>\n          </div>\n        </div>\n\n        <button class=\"mt-12 w-full py-3 border border-[var(--k-color-primary)]/30 text-[10px] font-bold uppercase tracking-widest hover:bg-[var(--k-color-primary)] hover:text-black transition-all\" data-kid=\"109\">\n          View All Sketches\n        </button>\n      </div>\n    </div>\n  </main>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js\" data-kid=\"110\"></script>\n<script data-kid=\"111\">\n  const ctx = document.getElementById('analyticsChart').getContext('2d');\n  new Chart(ctx, {\n    type: 'line',\n    data: {\n      labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],\n      datasets: [{\n        label: 'Clicks',\n        data: [65, 59, 80, 81, 56, 95, 120],\n        borderColor: '#DFFF00',\n        borderWidth: 3,\n        pointBackgroundColor: '#DFFF00',\n        pointRadius: 4,\n        tension: 0.4,\n        fill: true,\n        backgroundColor: 'rgba(223, 255, 0, 0.05)'\n      }]\n    },\n    options: {\n      responsive: true,\n      maintainAspectRatio: false,\n      plugins: {\n        legend: { display: false }\n      },\n      scales: {\n        y: {\n          grid: { color: 'rgba(255, 255, 255, 0.05)' },\n          ticks: { color: '#666', font: { family: 'Cabin' } }\n        },\n        x: {\n          grid: { display: false },\n          ticks: { color: '#666', font: { family: 'Cabin' } }\n        }\n      }\n    }\n  });\n</script>",
