      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Bitter:wght@700&family=Cabin:wght@400;500;700&display=swap');\n\n  @keyframes morph {\n    0% { border-radius: 40% 60% 60% 40% / 70% 30% 70% 30%; }\n    100% { border-radius: 60% 40% 40% 60% / 30% 70% 30% 70%; }\n  }\n\n  @keyframes ants {\n    to { stroke-dashoffset: -20; }\n  }\n\n  .morph-blob {\n    animation: morph 6s ease-in-out infinite alternate;\n  }\n\n  .marching-ants {\n    stroke-dasharray: 4;\n    animation: ants 1s linear infinite;\n  }\n\n  .crosshatch {\n    background-image: radial-gradient(#444 0.5px, transparent 0.5px);\n    background-size: 10px 10px;\n  }\n</style>\n\n<div class=\"flex h-[600px] w-full bg-[#2C2C2C] font-['Cabin'] text-[#E0E0E0] overflow-hidden relative crosshatch\" data-kid=\"1\">\n  \n  \n  <aside class=\"w-20 h-full bg-[#1A1A1A] border-r border-[#444/30] flex flex-col items-center py-8 z-20\" data-kid=\"2\">\n    <div class=\"mb-12\" data-kid=\"3\">\n      <div class=\"w-10 h-10 bg-[#DFFF00] flex items-center justify-center rounded-lg shadow-[0_0_15px_rgba(223,255,0,0.4)]\" data-kid=\"4\">\n        <i class=\"ti ti-link text-black text-xl\" data-kid=\"5\"></i>\n      </div>\n    </div>\n    \n    <nav class=\"flex flex-col gap-8 flex-1\" data-kid=\"6\">\n      <div class=\"relative group cursor-pointer\" data-kid=\"7\">\n        <div class=\"absolute inset-0 bg-[#DFFF00] morph-blob w-12 h-12 -left-1 -top-1 blur-sm opacity-20 scale-110\" data-kid=\"8\"></div>\n        <div class=\"absolute inset-0 bg-[#DFFF00] morph-blob w-12 h-12 -left-1 -top-1\" data-kid=\"9\"></div>\n        <div class=\"relative z-10 w-10 h-10 flex items-center justify-center text-black\" data-kid=\"10\">\n          <i class=\"ti ti-smart-home text-2xl\" data-kid=\"11\"></i>\n        </div>\n      </div>\n      \n      <div class=\"relative group cursor-pointer text-[#666] hover:text-[#E0E0E0] transition-colors\" data-kid=\"12\">\n        <div class=\"w-10 h-10 flex items-center justify-center\" data-kid=\"13\">\n          <i class=\"ti ti-chart-bar text-2xl\" data-kid=\"14\"></i>\n        </div>\n      </div>\n      \n      <div class=\"relative group cursor-pointer text-[#666] hover:text-[#E0E0E0] transition-colors\" data-kid=\"15\">\n        <div class=\"w-10 h-10 flex items-center justify-center\" data-kid=\"16\">\n          <i class=\"ti ti-history text-2xl\" data-kid=\"17\"></i>\n        </div>\n      </div>\n      \n      <div class=\"relative group cursor-pointer text-[#666] hover:text-[#E0E0E0] transition-colors\" data-kid=\"18\">\n        <div class=\"w-10 h-10 flex items-center justify-center\" data-kid=\"19\">\n          <i class=\"ti ti-settings text-2xl\" data-kid=\"20\"></i>\n        </div>\n      </div>\n    </nav>\n    \n    <div class=\"mt-auto\" data-kid=\"21\">\n      <div class=\"w-10 h-10 rounded-full border border-[#444] flex items-center justify-center hover:border-[#DFFF00] transition-colors cursor-pointer group\" data-kid=\"22\">\n        <i class=\"ti ti-user text-[#666] group-hover:text-[#DFFF00]\" data-kid=\"23\"></i>\n      </div>\n    </div>\n  </aside>\n\n  \n  <main class=\"flex-1 p-12 flex flex-col items-center justify-center\" data-kid=\"24\">\n    <div class=\"text-center\" data-kid=\"25\">\n      <h1 class=\"font-['Bitter'] text-5xl font-bold mb-4 tracking-tight\" style=\"text-shadow: 0 0 20px rgba(223,255,0,0.3);\" data-kid=\"26\">\n        Global Elements Showcase\n      </h1>\n      <p class=\"text-[#A0A0A0] text-lg max-w-md mx-auto\" data-kid=\"27\">\n        Redesigned navigation components following the \"WanderSketch Charcoal\" aesthetic.\n      </p>\n    </div>\n\n    \n    <footer class=\"absolute bottom-8 left-1/2 -translate-x-1/2 z-30\" data-kid=\"28\">\n      <div class=\"bg-[#111] px-6 py-3 rounded-full flex items-center gap-8 border border-[#333] shadow-[0_20px_50px_rgba(0,0,0,0.8)]\" data-kid=\"29\">\n        <div class=\"flex items-center gap-6\" data-kid=\"30\">\n          <a href=\"#\" class=\"text-xs font-bold uppercase tracking-widest text-[#DFFF00] hover:glow-sm transition-all\" data-kid=\"31\">Sketch</a>\n          <a href=\"#\" class=\"text-xs font-bold uppercase tracking-widest text-[#666] hover:text-[#E0E0E0] transition-all\" data-kid=\"32\">Vault</a>\n          <a href=\"#\" class=\"text-xs font-bold uppercase tracking-widest text-[#666] hover:text-[#E0E0E0] transition-all\" data-kid=\"33\">Market</a>\n        </div>\n        \n        <div class=\"h-4 w-px bg-[#333]\" data-kid=\"34\"></div>\n        \n        <div class=\"flex items-center gap-3\" data-kid=\"35\">\n          <span class=\"text-[10px] font-bold uppercase tracking-tighter text-[#666]\" data-kid=\"36\">Build</span>\n          <span class=\"text-[10px] font-bold text-[#E0E0E0] bg-[#222] px-2 py-0.5 rounded border border-[#333]\" data-kid=\"37\">v1.2.0-Alpha</span>\n        </div>\n        \n        <div class=\"flex items-center gap-2\" data-kid=\"38\">\n          <div class=\"w-1.5 h-1.5 rounded-full bg-[#DFFF00] animate-pulse\" data-kid=\"39\"></div>\n          <span class=\"text-[9px] font-bold uppercase text-[#666]\" data-kid=\"40\">Stable</span>\n        </div>\n      </div>\n    </footer>\n  </main>\n\n</div>\n\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css\" data-kid=\"41\">",
