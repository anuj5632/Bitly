      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Bitter:wght@700&family=Cabin:wght@400;500;700&display=swap');\n\n  :root {\n    --k-color-primary: #DFFF00;\n    --k-color-on-primary: #000000;\n    --k-color-surface: #2C2C2C;\n    --k-color-surface-card: #383838;\n    --k-color-on-surface: #E0E0E0;\n    --k-color-on-surface-muted: #666666;\n    --k-color-border: #444444;\n  }\n\n  @keyframes progress {\n    0% { width: 0%; }\n    100% { width: 100%; }\n  }\n\n  @keyframes lime-glow-pulse {\n    0%, 100% { filter: drop-shadow(0 0 5px var(--k-color-primary)); }\n    50% { filter: drop-shadow(0 0 15px var(--k-color-primary)); }\n  }\n\n  @keyframes floating {\n    0%, 100% { transform: translateY(0); }\n    50% { transform: translateY(-8px); }\n  }\n\n  .crosshatch {\n    background-image: repeating-linear-gradient(45deg, #333 0px, #333 1px, transparent 1px, transparent 10px);\n    background-size: 20px 20px;\n    opacity: 0.1;\n  }\n\n  .font-bitter { font-family: 'Bitter', serif; }\n  .font-cabin { font-family: 'Cabin', sans-serif; }\n\n  .lime-glow {\n    text-shadow: 0 0 10px rgba(223, 255, 0, 0.4);\n  }\n\n  .marching-ants {\n    background-image: linear-gradient(90deg, #444 50%, transparent 50%), linear-gradient(90deg, #444 50%, transparent 50%), linear-gradient(0deg, #444 50%, transparent 50%), linear-gradient(0deg, #444 50%, transparent 50%);\n    background-repeat: repeat-x, repeat-x, repeat-y, repeat-y;\n    background-size: 15px 1px, 15px 1px, 1px 15px, 1px 15px;\n    background-position: 0 0, 0 100%, 0 0, 100% 0;\n    animation: ants 10s linear infinite;\n  }\n\n  @keyframes ants {\n    to { background-position: 100% 0, -100% 100%, 0 -100%, 100% 100%; }\n  }\n</style>\n\n<div class=\"min-h-screen bg-[var(--k-color-surface)] text-[var(--k-color-on-surface)] font-cabin relative flex items-center justify-center overflow-hidden\" data-kid=\"1\">\n  \n  <div class=\"absolute inset-0 crosshatch pointer-events-none\" data-kid=\"2\"></div>\n\n  \n  <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[var(--k-color-primary)] opacity-5 blur-[120px] rounded-full\" data-kid=\"3\"></div>\n\n  <div class=\"relative z-10 flex flex-col items-center text-center px-6\" data-kid=\"4\">\n    \n    <div class=\"mb-12 relative\" data-kid=\"5\">\n      <div class=\"w-24 h-24 bg-[var(--k-color-surface-card)] border border-[var(--k-color-border)] rounded-xl shadow-[8px_8px_0_rgba(0,0,0,1)] rotate-[-2deg] flex items-center justify-center animate-[floating_4s_ease-in-out_infinite]\" data-kid=\"6\">\n        <i class=\"ti ti-external-link text-5xl text-[var(--k-color-primary)] lime-glow\" data-kid=\"7\"></i>\n      </div>\n      \n      <svg class=\"absolute -top-4 -right-4 w-12 h-12 text-[var(--k-color-primary)] opacity-40\" viewBox=\"0 0 100 100\" data-kid=\"8\">\n        <path d=\"M10,20 Q50,0 90,20 T10,60 T90,80\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"9\"></path>\n      </svg>\n    </div>\n\n    \n    <div class=\"relative mb-4\" data-kid=\"10\">\n      <h1 class=\"text-6xl font-bitter text-[var(--k-color-on-surface)] lime-glow tracking-tight\" data-kid=\"11\">\n        Redirecting<span class=\"text-[var(--k-color-primary)]\" data-kid=\"12\">...</span>\n      </h1>\n      \n      <svg class=\"absolute -bottom-2 left-0 w-full h-3 text-[var(--k-color-primary)] opacity-60\" preserveAspectRatio=\"none\" viewBox=\"0 0 100 10\" data-kid=\"13\">\n        <path d=\"M0,5 Q25,0 50,5 T100,5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"14\"></path>\n      </svg>\n    </div>\n\n    <p class=\"text-xl text-[var(--k-color-on-surface-muted)] max-w-md mb-12\" data-kid=\"15\">\n      Hang tight. We're sketches away from your destination.\n    </p>\n\n    \n    <div class=\"w-80 p-2 bg-[var(--k-color-surface-secondary)] border border-[var(--k-color-border)] rounded-full shadow-[4px_4px_0_rgba(0,0,0,1)] relative overflow-hidden\" data-kid=\"16\">\n      <div class=\"h-2 bg-[var(--k-color-primary)] rounded-full animate-[progress_2s_ease-in-out_infinite] lime-glow shadow-[0_0_15px_rgba(223,255,0,0.6)]\" data-kid=\"17\"></div>\n    </div>\n\n    \n    <div class=\"mt-16 inline-flex items-center gap-3 px-4 py-2 bg-[var(--k-color-surface-card)] rounded-full border border-[var(--k-color-border)] shadow-[4px_4px_0_rgba(0,0,0,1)]\" data-kid=\"18\">\n      <div class=\"w-2 h-2 rounded-full bg-[var(--k-color-primary)] animate-pulse shadow-[0_0_8px_var(--k-color-primary)]\" data-kid=\"19\"></div>\n      <span class=\"text-[10px] font-bold tracking-[0.2em] text-[var(--k-color-on-surface-muted)] uppercase\" data-kid=\"20\">Tracing Destination Trail</span>\n    </div>\n  </div>\n\n  \n  <div class=\"absolute bottom-10 right-10 opacity-10 rotate-12 pointer-events-none\" data-kid=\"21\">\n    <svg width=\"200\" height=\"150\" viewBox=\"0 0 200 150\" class=\"text-[var(--k-color-on-surface)]\" data-kid=\"22\">\n      <path d=\"M10,140 Q50,10 100,140 T190,10\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-kid=\"23\"></path>\n      <path d=\"M30,120 Q70,30 120,120 T170,30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"0.5\" data-kid=\"24\"></path>\n    </svg>\n  </div>\n</div>\n\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css\" data-kid=\"25\">",
