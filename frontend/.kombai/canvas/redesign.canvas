      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Bitter:wght@700&family=Cabin:wght@400;500;700&display=swap');\n\n  @keyframes morph {\n    0%, 100% { border-radius: 42% 58% 70% 30% / 45% 45% 55% 55%; transform: translate(-50%, -50%) rotate(0deg); }\n    33% { border-radius: 70% 30% 46% 54% / 30% 29% 71% 70%; transform: translate(-50%, -50%) rotate(120deg); }\n    66% { border-radius: 100% 60% 60% 100% / 100% 100% 60% 60%; transform: translate(-50%, -50%) rotate(240deg); }\n  }\n\n  @keyframes ants {\n    to { stroke-dashoffset: -100; }\n  }\n\n  .font-bitter { font-family: 'Bitter', serif; }\n  .font-cabin { font-family: 'Cabin', sans-serif; }\n  \n  .lime-glow {\n    text-shadow: 0 0 15px rgba(223, 255, 0, 0.4);\n  }\n\n  .chunky-shadow {\n    box-shadow: 8px 8px 0px 0px rgba(0, 0, 0, 1);\n  }\n\n  .marching-ants-border {\n    background-image: linear-gradient(90deg, #DFFF00 50%, transparent 50%), linear-gradient(90deg, #DFFF00 50%, transparent 50%), linear-gradient(0deg, #DFFF00 50%, transparent 50%), linear-gradient(0deg, #DFFF00 50%, transparent 50%);\n    background-repeat: repeat-x, repeat-x, repeat-y, repeat-y;\n    background-size: 15px 2px, 15px 2px, 2px 15px, 2px 15px;\n    animation: border-dance 4s infinite linear;\n  }\n\n  @keyframes border-dance {\n    0% { background-position: 0 0, 100% 100%, 0 100%, 100% 0; }\n    100% { background-position: 100% 0, 0 100%, 0 0, 100% 100%; }\n  }\n\n  .crosshatch {\n    background-image: radial-gradient(#444 0.5px, transparent 0.5px);\n    background-size: 10px 10px;\n  }\n</style>\n\n<div class=\"flex min-h-[900px] bg-[#2C2C2C] text-[#E0E0E0] font-cabin overflow-hidden\" data-kid=\"1\">\n  \n  <aside class=\"w-20 bg-[#1A1A1A] border-r border-[#444] flex flex-col items-center py-8 gap-10 shrink-0\" data-kid=\"2\">\n    <div class=\"w-10 h-10 bg-[#DFFF00] rounded-sm flex items-center justify-center text-black font-bitter font-bold text-xl\" data-kid=\"3\">L</div>\n    \n    <nav class=\"flex flex-col gap-8 relative w-full items-center\" data-kid=\"4\">\n      \n      <div class=\"absolute w-12 h-12 bg-[#DFFF00]/20 left-1/2 -translate-x-1/2 top-[52px]\" style=\"animation: morph 6s ease-in-out infinite alternate; filter: blur(4px);\" data-kid=\"5\"></div>\n      \n      <i class=\"ti ti-home-2 text-2xl text-[#666] hover:text-[#DFFF00] transition-colors cursor-pointer\" data-kid=\"6\"></i>\n      <i class=\"ti ti-user-plus text-2xl text-[#DFFF00] transition-colors cursor-pointer relative z-10\" data-kid=\"7\"></i>\n      <i class=\"ti ti-chart-bar text-2xl text-[#666] hover:text-[#DFFF00] transition-colors cursor-pointer\" data-kid=\"8\"></i>\n      <i class=\"ti ti-settings text-2xl text-[#666] hover:text-[#DFFF00] transition-colors cursor-pointer\" data-kid=\"9\"></i>\n    </nav>\n  </aside>\n\n  \n  <main class=\"flex-1 relative flex items-center justify-center p-12 crosshatch\" data-kid=\"10\">\n    \n    <div class=\"absolute top-20 right-20 w-64 h-64 border border-[#444] rotate-12 opacity-20 pointer-events-none\" data-kid=\"11\"></div>\n    <div class=\"absolute bottom-10 left-10 w-48 h-48 border border-[#444] -rotate-6 opacity-20 pointer-events-none\" data-kid=\"12\"></div>\n\n    <div class=\"w-full max-w-[480px] bg-[#383838] border border-[#444] p-10 chunky-shadow relative\" data-kid=\"13\">\n      \n      <div class=\"absolute -top-4 -left-4 bg-[#DFFF00] text-black font-bitter px-4 py-1 rotate-[-2deg] chunky-shadow text-sm font-bold tracking-widest uppercase\" data-kid=\"14\">\n        Join the sketch\n      </div>\n\n      <div class=\"mb-10 text-center\" data-kid=\"15\">\n        <h1 class=\"font-bitter text-4xl font-bold mb-3 lime-glow tracking-tight text-white leading-tight\" data-kid=\"16\">Create an<br data-kid=\"17\">Account</h1>\n        <p class=\"text-[#A0A0A0] text-sm\" data-kid=\"18\">Start your nocturnal journey with Linklytics</p>\n      </div>\n\n      <form class=\"space-y-6\" data-kid=\"19\">\n        \n        <div class=\"space-y-2\" data-kid=\"20\">\n          <label class=\"block text-[10px] font-bold uppercase tracking-[0.2em] text-[#666]\" data-kid=\"21\">Username</label>\n          <div class=\"relative group\" data-kid=\"22\">\n            <input type=\"text\" placeholder=\"sketch_artist_01\" class=\"w-full bg-[#2C2C2C] border border-[#444] px-4 py-3 text-sm focus:outline-none focus:border-[#DFFF00] transition-all group-hover:border-[#555]\" data-kid=\"23\">\n            <i class=\"ti ti-user absolute right-4 top-1/2 -translate-y-1/2 text-[#666] group-focus-within:text-[#DFFF00]\" data-kid=\"24\"></i>\n          </div>\n        </div>\n\n        \n        <div class=\"space-y-2\" data-kid=\"25\">\n          <label class=\"block text-[10px] font-bold uppercase tracking-[0.2em] text-[#666]\" data-kid=\"26\">Email Address</label>\n          <div class=\"relative group\" data-kid=\"27\">\n            <input type=\"email\" placeholder=\"artist@wandersketch.com\" class=\"w-full bg-[#2C2C2C] border border-[#444] px-4 py-3 text-sm focus:outline-none focus:border-[#DFFF00] transition-all group-hover:border-[#555]\" data-kid=\"28\">\n            <i class=\"ti ti-mail absolute right-4 top-1/2 -translate-y-1/2 text-[#666] group-focus-within:text-[#DFFF00]\" data-kid=\"29\"></i>\n          </div>\n        </div>\n\n        \n        <div class=\"space-y-2\" data-kid=\"30\">\n          <label class=\"block text-[10px] font-bold uppercase tracking-[0.2em] text-[#666]\" data-kid=\"31\">Password</label>\n          <div class=\"relative group\" data-kid=\"32\">\n            <input type=\"password\" placeholder=\"••••••••\" class=\"w-full bg-[#2C2C2C] border border-[#444] px-4 py-3 text-sm focus:outline-none focus:border-[#DFFF00] transition-all group-hover:border-[#555]\" data-kid=\"33\">\n            <i class=\"ti ti-lock absolute right-4 top-1/2 -translate-y-1/2 text-[#666] group-focus-within:text-[#DFFF00]\" data-kid=\"34\"></i>\n          </div>\n        </div>\n\n        \n        <button class=\"w-full relative py-4 font-bitter font-bold text-[#DFFF00] transition-all hover:text-black hover:bg-[#DFFF00] group overflow-hidden border border-transparent\" data-kid=\"35\">\n          <span class=\"relative z-10 tracking-widest uppercase text-sm\" data-kid=\"36\">Create Account</span>\n          \n          <div class=\"absolute inset-0 marching-ants-border opacity-60 group-hover:opacity-0 transition-opacity\" data-kid=\"37\"></div>\n          <div class=\"absolute inset-0 bg-[#DFFF00] translate-y-full group-hover:translate-y-0 transition-transform duration-300\" data-kid=\"38\"></div>\n        </button>\n      </form>\n\n      <div class=\"mt-10 pt-8 border-t border-[#444] text-center\" data-kid=\"39\">\n        <p class=\"text-[#A0A0A0] text-xs\" data-kid=\"40\">\n          Already a member? \n          <a href=\"#\" class=\"text-[#DFFF00] hover:underline ml-1 font-bold\" data-kid=\"41\">Sign in here</a>\n        </p>\n      </div>\n    </div>\n\n    \n    <footer class=\"absolute bottom-10 left-1/2 -translate-x-1/2 bg-[#1A1A1A] px-6 py-3 rounded-full border border-[#444] flex items-center gap-6 shadow-[0_20px_50px_rgba(0,0,0,0.8)]\" data-kid=\"42\">\n      <div class=\"flex items-center gap-2\" data-kid=\"43\">\n        <div class=\"w-2 h-2 rounded-full bg-[#4ADE80] animate-pulse\" data-kid=\"44\"></div>\n        <span class=\"text-[10px] text-[#666] font-bold tracking-widest uppercase\" data-kid=\"45\">Register Active</span>\n      </div>\n      <div class=\"h-4 w-[1px] bg-[#444]\" data-kid=\"46\"></div>\n      <span class=\"text-[10px] text-[#A0A0A0] font-bold\" data-kid=\"47\">V1.2.0-ALPHA</span>\n    </footer>\n  </main>\n</div>\n\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css\" data-kid=\"48\">",
