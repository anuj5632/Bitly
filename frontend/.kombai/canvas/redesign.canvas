      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Bitter:wght@700&family=Cabin:wght@400;500;700&display=swap');\n\n  @keyframes morph {\n    0%, 100% { border-radius: 42% 58% 70% 30% / 45% 45% 55% 55%; }\n    25% { border-radius: 70% 30% 46% 54% / 30% 29% 71% 70%; }\n    50% { border-radius: 50% 50% 34% 66% / 56% 68% 32% 44%; }\n    75% { border-radius: 46% 54% 50% 50% / 35% 61% 39% 65%; }\n  }\n\n  @keyframes marching-ants-anim {\n    0% { background-position: left top, right bottom, left bottom, right top; }\n    100% { background-position: left 10px top, right 10px bottom, left bottom 10px, right top 10px; }\n  }\n\n  .animate-morph {\n    animation: morph 8s ease-in-out infinite alternate;\n  }\n\n  .marching-ants {\n    background-image: linear-gradient(90deg, #DFFF00 50%, transparent 50%), \n                      linear-gradient(90deg, #DFFF00 50%, transparent 50%), \n                      linear-gradient(0deg, #DFFF00 50%, transparent 50%), \n                      linear-gradient(0deg, #DFFF00 50%, transparent 50%);\n    background-repeat: repeat-x, repeat-x, repeat-y, repeat-y;\n    background-size: 10px 2px, 10px 2px, 2px 10px, 2px 10px;\n    background-position: left top, right bottom, left bottom, right top;\n    animation: marching-ants-anim 1s infinite linear;\n  }\n\n  .torn-paper {\n    clip-path: polygon(0% 0%, 100% 0%, 100% 95%, 98% 98%, 95% 94%, 92% 99%, 88% 95%, 85% 98%, 80% 94%, 75% 99%, 70% 95%, 65% 98%, 60% 94%, 55% 99%, 50% 95%, 45% 98%, 40% 94%, 35% 99%, 30% 95%, 25% 98%, 20% 94%, 15% 99%, 10% 95%, 5% 98%, 0% 94%);\n  }\n\n  .crosshatch {\n    background-image: radial-gradient(#444 1px, transparent 1px);\n    background-size: 20px 20px;\n  }\n\n  .wabi-radius {\n    border-radius: 40px 10px 45px 12px / 15px 40px 10px 45px;\n  }\n</style>\n\n<div class=\"flex min-h-[4000px] bg-[#2C2C2C] text-[#E0E0E0] font-['Cabin']\" data-kid=\"1\">\n  \n  <aside class=\"fixed left-0 top-0 h-full w-20 bg-[#1A1A1A] border-r border-[#444] flex flex-col items-center py-8 z-50\" data-kid=\"2\">\n    <div class=\"mb-12 text-[#DFFF00]\" data-kid=\"3\">\n      <svg class=\"w-10 h-10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"4\"><path d=\"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71\" data-kid=\"5\"></path><path d=\"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71\" data-kid=\"6\"></path></svg>\n    </div>\n    <nav class=\"flex flex-col gap-8 relative\" data-kid=\"7\">\n      <div class=\"absolute -left-4 w-12 h-12 bg-[#DFFF00] opacity-20 blur-xl animate-morph\" data-kid=\"8\"></div>\n      <div class=\"absolute -left-1 top-0 w-1 h-12 bg-[#DFFF00] rounded-full shadow-[0_0_10px_#DFFF00]\" data-kid=\"9\"></div>\n      \n      <a href=\"#\" class=\"p-3 text-[#DFFF00] transition-colors\" data-kid=\"10\"><svg class=\"w-6 h-6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"11\"><path d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\" data-kid=\"12\"></path></svg></a>\n      <a href=\"#\" class=\"p-3 text-[#A0A0A0] hover:text-[#E0E0E0] transition-colors\" data-kid=\"13\"><svg class=\"w-6 h-6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"14\"><rect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"2\" ry=\"2\" data-kid=\"15\"></rect><line x1=\"3\" x2=\"21\" y1=\"9\" y2=\"9\" data-kid=\"16\"></line><line x1=\"9\" x2=\"9\" y1=\"21\" y2=\"9\" data-kid=\"17\"></line></svg></a>\n      <a href=\"#\" class=\"p-3 text-[#A0A0A0] hover:text-[#E0E0E0] transition-colors\" data-kid=\"18\"><svg class=\"w-6 h-6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"19\"><line x1=\"18\" x2=\"18\" y1=\"20\" y2=\"10\" data-kid=\"20\"></line><line x1=\"12\" x2=\"12\" y1=\"20\" y2=\"4\" data-kid=\"21\"></line><line x1=\"6\" x2=\"6\" y1=\"20\" y2=\"14\" data-kid=\"22\"></line></svg></a>\n      <a href=\"#\" class=\"p-3 text-[#A0A0A0] hover:text-[#E0E0E0] transition-colors\" data-kid=\"23\"><svg class=\"w-6 h-6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"24\"><path d=\"M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z\" data-kid=\"25\"></path><circle cx=\"12\" cy=\"12\" r=\"3\" data-kid=\"26\"></circle></svg></a>\n    </nav>\n  </aside>\n\n  <main class=\"ml-20 flex-1 relative crosshatch\" data-kid=\"27\">\n    \n    <section class=\"max-w-7xl mx-auto px-12 py-32 flex flex-col lg:flex-row items-center gap-20\" data-kid=\"28\">\n      <div class=\"flex-1\" data-kid=\"29\">\n        <div class=\"inline-block px-4 py-1 border border-[#DFFF00]/30 rounded-full text-[#DFFF00] text-xs font-bold uppercase tracking-widest mb-8\" data-kid=\"30\">\n          The smarter way to share links\n        </div>\n        <h1 class=\"font-['Bitter'] text-[72px] font-bold leading-[1.1] mb-8 text-[#E0E0E0] drop-shadow-[0_0_10px_rgba(223,255,0,0.3)]\" data-kid=\"31\">\n          Shorten <span class=\"text-[#DFFF00] drop-shadow-[0_0_20px_#DFFF00]\" data-kid=\"32\">URLs.</span><br data-kid=\"33\">\n          Amplify <span class=\"relative\" data-kid=\"34\">Results.<span class=\"absolute left-0 bottom-2 w-full h-1 bg-[#DFFF00] rotate-[-1deg]\" data-kid=\"35\"></span></span>\n        </h1>\n        <p class=\"text-[#A0A0A0] text-xl max-w-xl mb-12 font-medium\" data-kid=\"36\">\n          Linklytics streamlines URL shortening, making sharing links effortless and efficient. Generate concise, trackable URLs with a nocturnal edge.\n        </p>\n        \n        <div class=\"flex flex-wrap gap-6\" data-kid=\"37\">\n          <button class=\"relative group\" data-kid=\"38\">\n            <div class=\"absolute inset-0 bg-[#DFFF00] rounded-sm transform translate-x-2 translate-y-2 group-hover:translate-x-0 group-hover:translate-y-0 transition-transform\" data-kid=\"39\"></div>\n            <div class=\"relative bg-[#DFFF00] text-black px-8 py-4 font-bold rounded-sm border-2 border-black flex items-center gap-2\" data-kid=\"40\">\n              GET STARTED FREE <svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" data-kid=\"41\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\" data-kid=\"42\"></line><polyline points=\"12 5 19 12 12 19\" data-kid=\"43\"></polyline></svg>\n            </div>\n          </button>\n          \n          <button class=\"px-8 py-4 border-2 border-[#444] rounded-sm font-bold text-[#E0E0E0] hover:bg-[#383838] hover:border-[#DFFF00] transition-all flex items-center gap-2\" data-kid=\"44\">\n            VIEW DASHBOARD\n          </button>\n        </div>\n\n        <div class=\"mt-20 flex gap-12 border-t border-[#444] pt-12\" data-kid=\"45\">\n          <div data-kid=\"46\">\n            <div class=\"text-3xl font-bold text-[#E0E0E0]\" data-kid=\"47\">10M+</div>\n            <div class=\"text-[#666] text-sm uppercase tracking-wider font-bold\" data-kid=\"48\">Links Inked</div>\n          </div>\n          <div data-kid=\"49\">\n            <div class=\"text-3xl font-bold text-[#E0E0E0]\" data-kid=\"50\">50K+</div>\n            <div class=\"text-[#666] text-sm uppercase tracking-wider font-bold\" data-kid=\"51\">Night Owls</div>\n          </div>\n          <div data-kid=\"52\">\n            <div class=\"text-3xl font-bold text-[#E0E0E0]\" data-kid=\"53\">99.9%</div>\n            <div class=\"text-[#666] text-sm uppercase tracking-wider font-bold\" data-kid=\"54\">Uptime</div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"flex-1 relative\" data-kid=\"55\">\n        <div class=\"absolute -inset-10 bg-[#DFFF00]/5 blur-[100px] rounded-full\" data-kid=\"56\"></div>\n        <div class=\"relative bg-[#383838] p-10 shadow-[20px_20px_0_#000] rotate-[2deg] torn-paper border border-white/5\" data-kid=\"57\">\n          <div class=\"space-y-6\" data-kid=\"58\">\n            <div class=\"flex items-center gap-4 p-4 bg-[#1A1A1A] border border-[#444] rounded-sm\" data-kid=\"59\">\n              <div class=\"text-[#DFFF00]\" data-kid=\"60\"><svg class=\"w-6 h-6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"61\"><path d=\"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71\" data-kid=\"62\"></path><path d=\"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71\" data-kid=\"63\"></path></svg></div>\n              <span class=\"text-[#666] truncate font-mono\" data-kid=\"64\">https://long.url/charcoal-sketch...</span>\n            </div>\n            \n            <div class=\"flex items-center gap-4 p-4 bg-[#DFFF00]/10 border border-[#DFFF00]/30 rounded-sm group overflow-hidden relative\" data-kid=\"65\">\n              <div class=\"absolute inset-0 marching-ants opacity-20\" data-kid=\"66\"></div>\n              <div class=\"p-2 bg-[#DFFF00] rounded-sm text-black\" data-kid=\"67\">\n                <svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" data-kid=\"68\"><path d=\"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71\" data-kid=\"69\"></path><path d=\"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71\" data-kid=\"70\"></path></svg>\n              </div>\n              <span class=\"text-[#DFFF00] font-bold text-lg\" data-kid=\"71\">lnk.lyt/dark-mode</span>\n              <span class=\"ml-auto px-2 py-1 bg-[#DFFF00] text-black text-[10px] font-bold uppercase rounded-xs\" data-kid=\"72\">SHORTENED</span>\n            </div>\n\n            <div class=\"grid grid-cols-3 gap-4 pt-4\" data-kid=\"73\">\n              <div class=\"bg-[#1A1A1A] p-4 rounded-sm border border-[#444] text-center\" data-kid=\"74\">\n                <div class=\"text-[#DFFF00] text-xl font-bold\" data-kid=\"75\">1,234</div>\n                <div class=\"text-[#666] text-[10px] uppercase font-bold tracking-widest\" data-kid=\"76\">CLICKS</div>\n              </div>\n              <div class=\"bg-[#1A1A1A] p-4 rounded-sm border border-[#444] text-center\" data-kid=\"77\">\n                <div class=\"text-[#E0E0E0] text-xl font-bold\" data-kid=\"78\">12</div>\n                <div class=\"text-[#666] text-[10px] uppercase font-bold tracking-widest\" data-kid=\"79\">REGIONS</div>\n              </div>\n              <div class=\"bg-[#1A1A1A] p-4 rounded-sm border border-[#444] text-center\" data-kid=\"80\">\n                <div class=\"text-[#E0E0E0] text-xl font-bold\" data-kid=\"81\">456</div>\n                <div class=\"text-[#666] text-[10px] uppercase font-bold tracking-widest\" data-kid=\"82\">DEVICES</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"max-w-7xl mx-auto px-12 py-32\" data-kid=\"83\">\n      <div class=\"text-center mb-24\" data-kid=\"84\">\n        <h2 class=\"font-['Bitter'] text-[48px] font-bold text-[#E0E0E0] mb-6\" data-kid=\"85\">\n          Everything you need to <span class=\"text-[#DFFF00] drop-shadow-[0_0_10px_#DFFF00]\" data-kid=\"86\">manage links</span>\n        </h2>\n        <p class=\"text-[#A0A0A0] max-w-2xl mx-auto text-lg\" data-kid=\"87\">\n          Built for the meticulous creator. Powerful features to help you track and optimize your links with charcoal precision.\n        </p>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8\" data-kid=\"88\">\n        \n        <div class=\"bg-[#383838] p-8 border border-white/5 shadow-[6px_6px_0_#000] rotate-[-1.5deg] hover:rotate-0 hover:scale-105 transition-all duration-300\" data-kid=\"89\">\n          <div class=\"w-12 h-12 bg-[#1A1A1A] border border-[#444] text-[#DFFF00] flex items-center justify-center rounded-sm mb-6\" data-kid=\"90\">\n            <svg class=\"w-6 h-6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"91\"><path d=\"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71\" data-kid=\"92\"></path><path d=\"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71\" data-kid=\"93\"></path></svg>\n          </div>\n          <h3 class=\"font-['Bitter'] text-2xl font-bold mb-4\" data-kid=\"94\">Simple URL Shortening</h3>\n          <p class=\"text-[#A0A0A0] text-sm leading-relaxed\" data-kid=\"95\">\n            Create short, memorable URLs in just a few clicks. Intuitive charcoal interface for the modern nocturnal web.\n          </p>\n        </div>\n\n        \n        <div class=\"bg-[#383838] p-8 border border-white/5 shadow-[6px_6px_0_#000] rotate-[1deg] hover:rotate-0 hover:scale-105 transition-all duration-300\" data-kid=\"96\">\n          <div class=\"w-12 h-12 bg-[#1A1A1A] border border-[#444] text-[#DFFF00] flex items-center justify-center rounded-sm mb-6\" data-kid=\"97\">\n            <svg class=\"w-6 h-6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"98\"><line x1=\"18\" x2=\"18\" y1=\"20\" y2=\"10\" data-kid=\"99\"></line><line x1=\"12\" x2=\"12\" y1=\"20\" y2=\"4\" data-kid=\"100\"></line><line x1=\"6\" x2=\"6\" y1=\"20\" y2=\"14\" data-kid=\"101\"></line></svg>\n          </div>\n          <h3 class=\"font-['Bitter'] text-2xl font-bold mb-4\" data-kid=\"102\">Powerful Analytics</h3>\n          <p class=\"text-[#A0A0A0] text-sm leading-relaxed\" data-kid=\"103\">\n            Gain insights into your link performance. Track clicks and optimize your marketing with precision.\n          </p>\n        </div>\n\n        \n        <div class=\"bg-[#383838] p-8 border border-white/5 shadow-[6px_6px_0_#000] rotate-[-1deg] hover:rotate-0 hover:scale-105 transition-all duration-300\" data-kid=\"104\">\n          <div class=\"w-12 h-12 bg-[#1A1A1A] border border-[#444] text-[#DFFF00] flex items-center justify-center rounded-sm mb-6\" data-kid=\"105\">\n            <svg class=\"w-6 h-6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"106\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\" data-kid=\"107\"></path></svg>\n          </div>\n          <h3 class=\"font-['Bitter'] text-2xl font-bold mb-4\" data-kid=\"108\">Enhanced Security</h3>\n          <p class=\"text-[#A0A0A0] text-sm leading-relaxed\" data-kid=\"109\">\n            Rest assured with robust security measures. All shortened URLs are protected with advanced encryption.\n          </p>\n        </div>\n\n        \n        <div class=\"bg-[#383838] p-8 border border-white/5 shadow-[6px_6px_0_#000] rotate-[1.5deg] hover:rotate-0 hover:scale-105 transition-all duration-300\" data-kid=\"110\">\n          <div class=\"w-12 h-12 bg-[#1A1A1A] border border-[#444] text-[#DFFF00] flex items-center justify-center rounded-sm mb-6\" data-kid=\"111\">\n            <svg class=\"w-6 h-6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"112\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\" data-kid=\"113\"></path></svg>\n          </div>\n          <h3 class=\"font-['Bitter'] text-2xl font-bold mb-4\" data-kid=\"114\">Fast and Reliable</h3>\n          <p class=\"text-[#A0A0A0] text-sm leading-relaxed\" data-kid=\"115\">\n            Lightning-fast redirects and high uptime. Your links are always available, even in the dead of night.\n          </p>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"max-w-7xl mx-auto px-12 py-32 flex justify-center\" data-kid=\"116\">\n      <div class=\"max-w-3xl bg-[#383838] p-12 wabi-radius border border-white/10 shadow-[12px_12px_0_#000] relative\" data-kid=\"117\">\n        <div class=\"absolute -top-6 -left-6 text-[#DFFF00] opacity-20\" data-kid=\"118\"><svg class=\"w-20 h-20\" fill=\"currentColor\" viewBox=\"0 0 24 24\" data-kid=\"119\"><path d=\"M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H16.017C14.9124 8 14.017 7.10457 14.017 6V3H22.017V15C22.017 18.3137 19.3307 21 16.017 21H14.017ZM2.017 21L2.017 18C2.017 16.8954 2.91243 16 4.017 16H7.017C7.56928 16 8.017 15.5523 8.017 15V9C8.017 8.44772 7.56928 8 7.017 8H4.017C2.91243 8 2.017 7.10457 2.017 6V3H10.017V15C10.017 18.3137 7.33072 21 4.017 21H2.017Z\" data-kid=\"120\"></path></svg></div>\n        <p class=\"text-2xl font-medium leading-relaxed mb-8 italic text-[#E0E0E0]\" data-kid=\"121\">\n          \"Linklytics has completely transformed how we handle link distribution. The charcoal aesthetic is a breath of fresh air, and the analytics are unparalleled.\"\n        </p>\n        <div class=\"flex items-center gap-4\" data-kid=\"122\">\n          <div class=\"w-12 h-12 rounded-full bg-[#DFFF00] flex items-center justify-center text-black font-bold\" data-kid=\"123\">AS</div>\n          <div data-kid=\"124\">\n            <div class=\"font-bold text-[#E0E0E0]\" data-kid=\"125\">Alex Sketch</div>\n            <div class=\"text-[#666] text-xs uppercase tracking-widest\" data-kid=\"126\">Lead Nocturnal Designer</div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"max-w-7xl mx-auto px-12 py-32 mb-20\" data-kid=\"127\">\n      <div class=\"relative bg-[#1A1A1A] border border-[#444] p-20 text-center shadow-[12px_12px_0_#000] overflow-hidden\" data-kid=\"128\">\n        <div class=\"absolute top-0 right-0 w-64 h-64 bg-[#DFFF00]/5 blur-[80px] rounded-full\" data-kid=\"129\"></div>\n        <div class=\"absolute bottom-0 left-0 w-64 h-64 bg-[#DFFF00]/5 blur-[80px] rounded-full\" data-kid=\"130\"></div>\n        \n        <div class=\"relative z-10\" data-kid=\"131\">\n          <h2 class=\"font-['Bitter'] text-[48px] font-bold text-[#E0E0E0] mb-8\" data-kid=\"132\">\n            Ready to ink your first link?\n          </h2>\n          <p class=\"text-[#A0A0A0] max-w-xl mx-auto mb-12 text-lg\" data-kid=\"133\">\n            Join thousands of users who trust Linklytics for their URL management needs. Start shortening for free today.\n          </p>\n          <button class=\"relative group mx-auto\" data-kid=\"134\">\n            <div class=\"absolute inset-0 bg-[#DFFF00] rounded-sm transform translate-x-2 translate-y-2 group-hover:translate-x-0 group-hover:translate-y-0 transition-transform\" data-kid=\"135\"></div>\n            <div class=\"relative bg-[#DFFF00] text-black px-12 py-5 font-bold rounded-sm border-2 border-black flex items-center gap-2 text-lg\" data-kid=\"136\">\n              START SHORTENING FREE\n            </div>\n          </button>\n        </div>\n        \n        \n        <div class=\"absolute bottom-0 left-0 w-full h-1 marching-ants\" data-kid=\"137\"></div>\n      </div>\n    </section>\n\n    \n    <footer class=\"fixed bottom-8 left-1/2 -translate-x-1/2 bg-[#1A1A1A] border border-[#444] rounded-full px-8 py-4 flex items-center gap-8 shadow-[0_20px_50px_rgba(0,0,0,0.8)] z-50\" data-kid=\"138\">\n      <div class=\"text-[#DFFF00] font-bold uppercase tracking-widest text-xs\" data-kid=\"139\">Linklytics v2.0</div>\n      <div class=\"w-px h-4 bg-[#444]\" data-kid=\"140\"></div>\n      <div class=\"flex gap-6 text-[#A0A0A0] text-xs font-bold uppercase\" data-kid=\"141\">\n        <a href=\"#\" class=\"hover:text-[#DFFF00]\" data-kid=\"142\">About</a>\n        <a href=\"#\" class=\"hover:text-[#DFFF00]\" data-kid=\"143\">Privacy</a>\n        <a href=\"#\" class=\"hover:text-[#DFFF00]\" data-kid=\"144\">Terms</a>\n      </div>\n      <div class=\"w-px h-4 bg-[#444]\" data-kid=\"145\"></div>\n      <div class=\"flex gap-4\" data-kid=\"146\">\n        <div class=\"w-2 h-2 bg-green-500 rounded-full animate-pulse\" data-kid=\"147\"></div>\n        <span class=\"text-[10px] text-[#666] font-bold\" data-kid=\"148\">ALL SYSTEMS NOMINAL</span>\n      </div>\n    </footer>\n  </main>\n</div>",
