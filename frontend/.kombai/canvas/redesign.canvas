      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Bitter:wght@700&family=Cabin:wght@400;500;700&display=swap');\n\n  :root {\n    --k-color-primary: #DFFF00;\n    --k-color-primary-hover: #EFFF33;\n    --k-color-on-primary: #000000;\n    --k-color-surface: #2C2C2C;\n    --k-color-surface-card: #383838;\n    --k-color-on-surface: #E0E0E0;\n    --k-color-on-surface-muted: #666666;\n    --k-color-border: #444444;\n    \n    --k-font-heading: \"Bitter\", serif;\n    --k-font-body: \"Cabin\", sans-serif;\n  }\n\n  body {\n    background-color: var(--k-color-surface);\n    font-family: var(--k-font-body);\n    color: var(--k-color-on-surface);\n    margin: 0;\n  }\n\n  .lime-glow {\n    text-shadow: 0 0 15px rgba(223, 255, 0, 0.4);\n  }\n\n  .neomorph-inset {\n    background: var(--k-color-surface-card);\n    box-shadow: inset 4px 4px 8px rgba(0, 0, 0, 0.4), \n                inset -2px -2px 6px rgba(255, 255, 255, 0.05);\n    border: 1px solid rgba(0, 0, 0, 0.2);\n  }\n\n  .neomorph-inset:focus-within {\n    border-color: var(--k-color-primary);\n    box-shadow: inset 4px 4px 8px rgba(0, 0, 0, 0.5), \n                inset -2px -2px 6px rgba(255, 255, 255, 0.05),\n                0 0 10px rgba(223, 255, 0, 0.1);\n  }\n\n  .marching-ants {\n    position: relative;\n    padding: 2px;\n    background: transparent;\n    overflow: hidden;\n  }\n\n  .marching-ants::before {\n    content: '';\n    position: absolute;\n    top: 0; left: 0; right: 0; bottom: 0;\n    border: 2px dashed var(--k-color-on-surface-muted);\n    border-radius: 4px;\n    animation: ants 12s linear infinite;\n  }\n\n  @keyframes ants {\n    from { stroke-dashoffset: 0; }\n    to { stroke-dashoffset: 100%; }\n  }\n\n  /* Simpler marching ants using linear gradient mask */\n  .marching-ants-border {\n    background-image: linear-gradient(90deg, var(--k-color-on-surface-muted) 50%, transparent 50%), \n                      linear-gradient(90deg, var(--k-color-on-surface-muted) 50%, transparent 50%), \n                      linear-gradient(0deg, var(--k-color-on-surface-muted) 50%, transparent 50%), \n                      linear-gradient(0deg, var(--k-color-on-surface-muted) 50%, transparent 50%);\n    background-repeat: repeat-x, repeat-x, repeat-y, repeat-y;\n    background-size: 15px 2px, 15px 2px, 2px 15px, 2px 15px;\n    background-position: 0 0, 0 100%, 0 0, 100% 0;\n    animation: border-marching 0.4s infinite linear;\n  }\n\n  @keyframes border-marching {\n    from { background-position: 0 0, 0 100%, 0 0, 100% 0; }\n    to { background-position: 15px 0, -15px 100%, 0 -15px, 100% 15px; }\n  }\n\n  .marching-ants-btn:hover {\n    background: var(--k-color-primary);\n    color: var(--k-color-on-primary);\n    border-image: none;\n    background-image: none;\n  }\n\n  .crosshatch {\n    background-image: radial-gradient(var(--k-color-border) 1px, transparent 1px);\n    background-size: 20px 20px;\n  }\n\n  .wabi-tilt {\n    transform: rotate(-1.5deg);\n    transition: transform 0.3s ease;\n  }\n\n  .wabi-tilt:hover {\n    transform: rotate(0deg) scale(1.01);\n  }\n\n  .scribble-underline {\n    position: relative;\n    display: inline-block;\n  }\n\n  .scribble-underline::after {\n    content: '';\n    position: absolute;\n    bottom: -8px;\n    left: -5%;\n    width: 110%;\n    height: 12px;\n    background: url(\"data:image/svg+xml,%3Csvg width='200' height='20' viewBox='0 0 200 20' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M5 15 Q 50 5 100 15 T 195 10' stroke='%23DFFF00' stroke-width='3' fill='none' stroke-linecap='round'/%3E%3C/svg%3E\") no-repeat center;\n    background-size: contain;\n    opacity: 0.8;\n  }\n\n  .morph-blob {\n    width: 300px;\n    height: 300px;\n    background: var(--k-color-primary);\n    filter: blur(80px);\n    opacity: 0.08;\n    border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;\n    animation: morph 8s ease-in-out infinite alternate;\n  }\n\n  @keyframes morph {\n    0% { border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; }\n    100% { border-radius: 60% 40% 30% 70% / 50% 60% 40% 60%; }\n  }\n</style>\n\n<div class=\"min-h-[800px] w-full flex items-center justify-center relative overflow-hidden crosshatch\" data-kid=\"1\">\n  \n  <div class=\"absolute -top-20 -left-20 morph-blob\" data-kid=\"2\"></div>\n  <div class=\"absolute -bottom-20 -right-20 morph-blob\" style=\"animation-delay: -4s;\" data-kid=\"3\"></div>\n\n  \n  <div class=\"w-full max-w-[480px] p-8 relative z-10\" data-kid=\"4\">\n    <div class=\"bg-[#383838] p-10 rounded-lg wabi-tilt shadow-[12px_12px_0px_rgba(0,0,0,1)] border border-[#444]\" data-kid=\"5\">\n      \n      \n      <div class=\"mb-10 text-center\" data-kid=\"6\">\n        <div class=\"inline-block mb-4\" data-kid=\"7\">\n          <i class=\"ti ti-lock-access text-[40px] text-[#DFFF00] lime-glow\" data-kid=\"8\"></i>\n        </div>\n        <h1 class=\"font-['Bitter'] text-[36px] font-bold text-[#E0E0E0] mb-2 scribble-underline\" data-kid=\"9\">\n          Welcome back\n        </h1>\n        <p class=\"text-[#A0A0A0] uppercase tracking-widest text-[12px] font-bold mt-4\" data-kid=\"10\">\n          Nocturnal Access Required\n        </p>\n      </div>\n\n      \n      <form class=\"space-y-8\" data-kid=\"11\">\n        \n        <div class=\"space-y-2\" data-kid=\"12\">\n          <label class=\"text-[#A0A0A0] text-[12px] font-bold uppercase tracking-widest block ml-1\" data-kid=\"13\">\n            Username\n          </label>\n          <div class=\"neomorph-inset rounded-md flex items-center px-4 py-3 group\" data-kid=\"14\">\n            <i class=\"ti ti-user text-[#666] group-focus-within:text-[#DFFF00] transition-colors mr-3\" data-kid=\"15\"></i>\n            <input type=\"text\" placeholder=\"sketcher_01\" class=\"bg-transparent border-none outline-hidden text-[#E0E0E0] w-full placeholder-[#666] font-['Cabin']\" data-kid=\"16\">\n          </div>\n        </div>\n\n        \n        <div class=\"space-y-2\" data-kid=\"17\">\n          <div class=\"flex justify-between items-center ml-1\" data-kid=\"18\">\n            <label class=\"text-[#A0A0A0] text-[12px] font-bold uppercase tracking-widest block\" data-kid=\"19\">\n              Password\n            </label>\n            <a href=\"#\" class=\"text-[#666] hover:text-[#DFFF00] text-[11px] font-bold uppercase tracking-tighter transition-colors\" data-kid=\"20\">\n              Lost keys?\n            </a>\n          </div>\n          <div class=\"neomorph-inset rounded-md flex items-center px-4 py-3 group\" data-kid=\"21\">\n            <i class=\"ti ti-key text-[#666] group-focus-within:text-[#DFFF00] transition-colors mr-3\" data-kid=\"22\"></i>\n            <input type=\"password\" placeholder=\"••••••••\" class=\"bg-transparent border-none outline-hidden text-[#E0E0E0] w-full placeholder-[#666] font-['Cabin']\" data-kid=\"23\">\n          </div>\n        </div>\n\n        \n        <div class=\"pt-4\" data-kid=\"24\">\n          <button type=\"submit\" class=\"marching-ants-btn marching-ants-border w-full py-4 text-[#DFFF00] font-bold uppercase tracking-[0.2em] transition-all duration-300 rounded-sm cursor-pointer border-none bg-transparent\" data-kid=\"25\">\n            Authenticate\n          </button>\n        </div>\n      </form>\n\n      \n      <div class=\"mt-10 pt-8 border-t border-[#444] text-center\" data-kid=\"26\">\n        <p class=\"text-[#666] text-[13px]\" data-kid=\"27\">\n          New to the nocturne? \n          <a href=\"#\" class=\"text-[#DFFF00] font-bold hover:underline ml-1\" data-kid=\"28\">\n            Register Sketchbook\n          </a>\n        </p>\n      </div>\n    </div>\n\n    \n    <div class=\"mt-8 flex justify-center items-center space-x-2\" data-kid=\"29\">\n      <div class=\"w-1.5 h-1.5 rounded-full bg-[#DFFF00] animate-pulse\" data-kid=\"30\"></div>\n      <span class=\"text-[10px] text-[#666] font-bold tracking-[0.3em] uppercase\" data-kid=\"31\">Secure Channel Alpha</span>\n    </div>\n  </div>\n</div>\n\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css\" data-kid=\"32\">",
