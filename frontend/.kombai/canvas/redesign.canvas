      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,100..900;1,100..900&family=Cabin:ital,wght@0,400..700;1,400..700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n  :root {\n    --k-color-primary: #DFFF00;\n    --k-color-on-primary: #000000;\n    --k-color-surface: #2C2C2C;\n    --k-color-surface-card: #383838;\n    --k-color-surface-secondary: #1A1A1A;\n    --k-color-on-surface: #E0E0E0;\n    --k-color-on-surface-secondary: #A0A0A0;\n    --k-color-border: #444444;\n    --k-font-family-heading: \"Bitter\", serif;\n    --k-font-family-body: \"Cabin\", sans-serif;\n  }\n\n  body {\n    background-color: var(--k-color-surface);\n    color: var(--k-color-on-surface);\n    font-family: var(--k-font-family-body);\n    margin: 0;\n  }\n\n  .font-heading { font-family: var(--k-font-family-heading); }\n  .font-body { font-family: var(--k-font-family-body); }\n\n  .lime-glow {\n    text-shadow: 0 0 20px rgba(223, 255, 0, 0.4), 0 0 40px rgba(223, 255, 0, 0.2);\n  }\n\n  .marching-ants-btn {\n    position: relative;\n    padding: 12px 24px;\n    background: transparent;\n    color: var(--k-color-on-surface);\n    border: 2px dashed #ffffff;\n    border-radius: 4px;\n    overflow: hidden;\n    transition: all 0.3s ease;\n  }\n\n  .marching-ants-btn:hover {\n    border-style: solid;\n    background: var(--k-color-primary);\n    color: var(--k-color-on-primary);\n    border-color: var(--k-color-primary);\n  }\n\n  .marching-ants-btn::before {\n    content: '';\n    position: absolute;\n    inset: -2px;\n    border: 2px dashed var(--k-color-primary);\n    border-radius: 4px;\n    animation: ants 10s linear infinite;\n    pointer-events: none;\n    opacity: 0.5;\n  }\n\n  @keyframes ants {\n    from { stroke-dashoffset: 0; }\n    to { stroke-dashoffset: 100; }\n  }\n\n  .chunky-shadow {\n    box-shadow: 12px 12px 0px 0px rgba(0,0,0,0.8);\n  }\n\n  .tilted-card {\n    transform: rotate(-1.5deg);\n    transition: transform 0.3s ease, box-shadow 0.3s ease;\n  }\n\n  .tilted-card:hover {\n    transform: rotate(0deg) scale(1.02);\n  }\n\n  .scribble-underline {\n    position: relative;\n  }\n\n  .scribble-underline::after {\n    content: '';\n    position: absolute;\n    bottom: -8px;\n    left: 0;\n    width: 100%;\n    height: 8px;\n    background-image: url(\"data:image/svg+xml,%3Csvg width='200' height='8' viewBox='0 0 200 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M2 5.5C25 2.5 50 7.5 75 4.5C100 1.5 125 6.5 150 3.5C175 0.5 198 5.5 198 5.5' stroke='%23DFFF00' stroke-width='3' stroke-linecap='round'/%3E%3C/svg%3E\");\n    background-size: 100% 100%;\n    background-repeat: no-repeat;\n  }\n\n  .crosshatch {\n    background-image: radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1px);\n    background-size: 20px 20px;\n  }\n</style>\n\n<div class=\"min-h-[1000px] crosshatch\" data-kid=\"1\">\n  \n  <nav class=\"flex items-center justify-between px-12 py-8 relative z-20\" data-kid=\"2\">\n    <div class=\"flex items-center gap-3\" data-kid=\"3\">\n      <div class=\"w-10 h-10 bg-(--k-color-primary) rounded-sm flex items-center justify-center\" data-kid=\"4\">\n        <i class=\"ti ti-link text-black text-2xl\" data-kid=\"5\"></i>\n      </div>\n      <span class=\"font-heading text-2xl font-bold tracking-tight\" data-kid=\"6\">Linklytics</span>\n    </div>\n    <div class=\"flex items-center gap-8\" data-kid=\"7\">\n      <a href=\"#\" class=\"text-sm font-bold uppercase tracking-widest hover:text-(--k-color-primary)\" data-kid=\"8\">Features</a>\n      <a href=\"#\" class=\"text-sm font-bold uppercase tracking-widest hover:text-(--k-color-primary)\" data-kid=\"9\">Pricing</a>\n      <button class=\"marching-ants-btn font-bold uppercase tracking-widest text-xs\" data-kid=\"10\">\n        Get Started\n      </button>\n    </div>\n  </nav>\n\n  \n  <section class=\"relative px-12 pt-20 pb-32 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\" data-kid=\"11\">\n    <div class=\"relative z-10\" data-kid=\"12\">\n      <div class=\"inline-block px-3 py-1 bg-(--k-color-primary)/10 border border-(--k-color-primary)/20 rounded-xs mb-6\" data-kid=\"13\">\n        <span class=\"text-(--k-color-primary) text-[12px] font-bold uppercase tracking-widest\" data-kid=\"14\">Nocturnal URL Engine v1.0</span>\n      </div>\n      <h1 class=\"font-heading text-7xl font-bold leading-[1.1] mb-8 lime-glow\" data-kid=\"15\">\n        Shorten URLs.<br data-kid=\"16\">\n        <span class=\"scribble-underline\" data-kid=\"17\">Amplify Results.</span>\n      </h1>\n      <p class=\"text-xl text-(--k-color-on-surface-secondary) max-w-lg mb-12 leading-relaxed\" data-kid=\"18\">\n        Linklytics streamlines URL shortening, making sharing links effortless and efficient. \n        Generate concise, trackable URLs in seconds with powerful analytics.\n      </p>\n      \n      <div class=\"flex items-center gap-6\" data-kid=\"19\">\n        <button class=\"px-8 py-4 bg-(--k-color-primary) text-black font-bold rounded-xs chunky-shadow hover:translate-y-[-2px] transition-transform\" data-kid=\"20\">\n          Start for Free\n        </button>\n        <button class=\"px-8 py-4 border border-(--k-color-border) font-bold rounded-xs hover:bg-(--k-color-border)/20 transition-colors\" data-kid=\"21\">\n          View Demo\n        </button>\n      </div>\n\n      \n      <div class=\"mt-20 flex gap-12 border-t border-(--k-color-border) pt-8\" data-kid=\"22\">\n        <div data-kid=\"23\">\n          <div class=\"font-heading text-3xl font-bold text-(--k-color-primary)\" data-kid=\"24\">10M+</div>\n          <div class=\"text-[12px] font-bold uppercase tracking-widest text-(--k-color-on-surface-muted)\" data-kid=\"25\">Links Created</div>\n        </div>\n        <div data-kid=\"26\">\n          <div class=\"font-heading text-3xl font-bold text-(--k-color-primary)\" data-kid=\"27\">50K+</div>\n          <div class=\"text-[12px] font-bold uppercase tracking-widest text-(--k-color-on-surface-muted)\" data-kid=\"28\">Active Users</div>\n        </div>\n        <div data-kid=\"29\">\n          <div class=\"font-heading text-3xl font-bold text-(--k-color-primary)\" data-kid=\"30\">99.9%</div>\n          <div class=\"text-[12px] font-bold uppercase tracking-widest text-(--k-color-on-surface-muted)\" data-kid=\"31\">Uptime</div>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"relative\" data-kid=\"32\">\n      <div class=\"absolute -inset-10 bg-(--k-color-primary)/5 blur-[100px] rounded-full\" data-kid=\"33\"></div>\n      \n      \n      <div class=\"relative bg-(--k-color-surface-card) border border-(--k-color-border) p-8 rounded-md chunky-shadow tilted-card\" data-kid=\"34\">\n        <div class=\"flex items-center gap-3 p-4 bg-(--k-color-surface-secondary) border border-(--k-color-border) rounded-xs mb-6\" data-kid=\"35\">\n          <i class=\"ti ti-link text-(--k-color-primary)\" data-kid=\"36\"></i>\n          <span class=\"text-sm text-(--k-color-on-surface-secondary) truncate\" data-kid=\"37\">https://sketch.com/nocturnal-sketch-url-very-long</span>\n        </div>\n        \n        <div class=\"flex items-center gap-3 p-4 bg-(--k-color-primary)/10 border border-(--k-color-primary)/30 rounded-xs mb-8\" data-kid=\"38\">\n          <div class=\"w-8 h-8 bg-(--k-color-primary) rounded-xs flex items-center justify-center\" data-kid=\"39\">\n            <i class=\"ti ti-link text-black\" data-kid=\"40\"></i>\n          </div>\n          <span class=\"font-bold text-(--k-color-primary)\" data-kid=\"41\">lnklyt.cs/abc123</span>\n          <span class=\"ml-auto text-[10px] font-bold uppercase bg-(--k-color-primary) text-black px-2 py-0.5 rounded-full\" data-kid=\"42\">Shortened!</span>\n        </div>\n\n        <div class=\"grid grid-cols-3 gap-4\" data-kid=\"43\">\n          <div class=\"bg-(--k-color-surface-secondary) p-4 rounded-xs border border-(--k-color-border)\" data-kid=\"44\">\n            <div class=\"text-2xl font-heading font-bold\" data-kid=\"45\">1,234</div>\n            <div class=\"text-[10px] font-bold uppercase text-(--k-color-on-surface-muted)\" data-kid=\"46\">Clicks</div>\n          </div>\n          <div class=\"bg-(--k-color-surface-secondary) p-4 rounded-xs border border-(--k-color-border)\" data-kid=\"47\">\n            <div class=\"text-2xl font-heading font-bold\" data-kid=\"48\">12</div>\n            <div class=\"text-[10px] font-bold uppercase text-(--k-color-on-surface-muted)\" data-kid=\"49\">Countries</div>\n          </div>\n          <div class=\"bg-(--k-color-surface-secondary) p-4 rounded-xs border border-(--k-color-border)\" data-kid=\"50\">\n            <div class=\"text-2xl font-heading font-bold\" data-kid=\"51\">456</div>\n            <div class=\"text-[10px] font-bold uppercase text-(--k-color-on-surface-muted)\" data-kid=\"52\">Devices</div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"absolute -top-10 -right-10 w-32 h-32 border border-(--k-color-primary)/20 border-dashed rounded-full animate-pulse\" data-kid=\"53\"></div>\n      <div class=\"absolute -bottom-20 -left-10 text-6xl opacity-20 rotate-[-15deg]\" data-kid=\"54\">✨</div>\n    </div>\n  </section>\n\n  \n  <section class=\"px-12 py-32 bg-(--k-color-surface-secondary)\" data-kid=\"55\">\n    <div class=\"text-center mb-24\" data-kid=\"56\">\n      <h2 class=\"font-heading text-5xl font-bold mb-6\" data-kid=\"57\">Nocturnal Toolset</h2>\n      <p class=\"text-(--k-color-on-surface-secondary) max-w-2xl mx-auto text-lg\" data-kid=\"58\">\n        Everything you need to manage links in the dark. Powerful, precise, and electric.\n      </p>\n    </div>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8\" data-kid=\"59\">\n      \n      <div class=\"bg-(--k-color-surface-card) border border-(--k-color-border) p-8 rounded-md chunky-shadow tilted-card group\" data-kid=\"60\">\n        <div class=\"w-12 h-12 bg-(--k-color-primary)/10 border border-(--k-color-primary)/20 rounded-xs flex items-center justify-center mb-6 group-hover:bg-(--k-color-primary) transition-colors\" data-kid=\"61\">\n          <i class=\"ti ti-link text-2xl text-(--k-color-primary) group-hover:text-black\" data-kid=\"62\"></i>\n        </div>\n        <h3 class=\"font-heading text-xl font-bold mb-4\" data-kid=\"63\">Simple URL Shortening</h3>\n        <p class=\"text-sm text-(--k-color-on-surface-secondary) leading-relaxed\" data-kid=\"64\">\n          Create short, memorable URLs in just a few clicks. Our intuitive interface ensures no hassle.\n        </p>\n      </div>\n\n      \n      <div class=\"bg-(--k-color-surface-card) border border-(--k-color-border) p-8 rounded-md chunky-shadow tilted-card group translate-y-4\" data-kid=\"65\">\n        <div class=\"w-12 h-12 bg-(--k-color-primary)/10 border border-(--k-color-primary)/20 rounded-xs flex items-center justify-center mb-6 group-hover:bg-(--k-color-primary) transition-colors\" data-kid=\"66\">\n          <i class=\"ti ti-chart-bar text-2xl text-(--k-color-primary) group-hover:text-black\" data-kid=\"67\"></i>\n        </div>\n        <h3 class=\"font-heading text-xl font-bold mb-4\" data-kid=\"68\">Powerful Analytics</h3>\n        <p class=\"text-sm text-(--k-color-on-surface-secondary) leading-relaxed\" data-kid=\"69\">\n          Gain insights into your link performance with our comprehensive analytics dashboard.\n        </p>\n      </div>\n\n      \n      <div class=\"bg-(--k-color-surface-card) border border-(--k-color-border) p-8 rounded-md chunky-shadow tilted-card group\" data-kid=\"70\">\n        <div class=\"w-12 h-12 bg-(--k-color-primary)/10 border border-(--k-color-primary)/20 rounded-xs flex items-center justify-center mb-6 group-hover:bg-(--k-color-primary) transition-colors\" data-kid=\"71\">\n          <i class=\"ti ti-shield-lock text-2xl text-(--k-color-primary) group-hover:text-black\" data-kid=\"72\"></i>\n        </div>\n        <h3 class=\"font-heading text-xl font-bold mb-4\" data-kid=\"73\">Enhanced Security</h3>\n        <p class=\"text-sm text-(--k-color-on-surface-secondary) leading-relaxed\" data-kid=\"74\">\n          Rest assured with our robust security measures. All shortened URLs are protected.\n        </p>\n      </div>\n\n      \n      <div class=\"bg-(--k-color-surface-card) border border-(--k-color-border) p-8 rounded-md chunky-shadow tilted-card group translate-y-4\" data-kid=\"75\">\n        <div class=\"w-12 h-12 bg-(--k-color-primary)/10 border border-(--k-color-primary)/20 rounded-xs flex items-center justify-center mb-6 group-hover:bg-(--k-color-primary) transition-colors\" data-kid=\"76\">\n          <i class=\"ti ti-zap text-2xl text-(--k-color-primary) group-hover:text-black\" data-kid=\"77\"></i>\n        </div>\n        <h3 class=\"font-heading text-xl font-bold mb-4\" data-kid=\"78\">Fast and Reliable</h3>\n        <p class=\"text-sm text-(--k-color-on-surface-secondary) leading-relaxed\" data-kid=\"79\">\n          Enjoy lightning-fast redirects and high uptime with our reliable infrastructure.\n        </p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"px-12 py-32 relative overflow-hidden\" data-kid=\"80\">\n    <div class=\"max-w-4xl mx-auto bg-(--k-color-surface-card) border border-(--k-color-border) rounded-md p-16 text-center chunky-shadow relative\" data-kid=\"81\">\n      \n      <div class=\"absolute top-0 left-0 w-full h-4 bg-repeat-x opacity-20\" style=\"background-image: radial-gradient(circle, var(--k-color-surface) 5px, transparent 6px); background-size: 20px 20px; top: -10px;\" data-kid=\"82\"></div>\n      \n      <h2 class=\"font-heading text-5xl font-bold mb-6\" data-kid=\"83\">Ready to Sketch your Links?</h2>\n      <p class=\"text-(--k-color-on-surface-secondary) text-lg mb-12 max-w-xl mx-auto\" data-kid=\"84\">\n        Join thousands of users who trust Linklytics for their URL management needs.\n      </p>\n      \n      <button class=\"marching-ants-btn px-12 py-6 text-lg font-bold uppercase tracking-[0.2em]\" data-kid=\"85\">\n        Start Shortening Now\n      </button>\n\n      \n      <svg class=\"absolute bottom-10 right-10 w-24 opacity-20\" viewBox=\"0 0 100 20\" data-kid=\"86\">\n        <path d=\"M0,10 Q25,0 50,10 T100,10\" stroke=\"var(--k-color-primary)\" fill=\"none\" stroke-width=\"2\" data-kid=\"87\"></path>\n      </svg>\n    </div>\n  </section>\n\n  \n  <footer class=\"fixed bottom-8 left-1/2 -translate-x-1/2 px-8 py-4 bg-(--k-color-surface-secondary) border border-(--k-color-border) rounded-full flex items-center gap-12 shadow-[0_20px_50px_rgba(0,0,0,0.8)] z-50\" data-kid=\"88\">\n    <div class=\"flex items-center gap-2\" data-kid=\"89\">\n      <div class=\"w-6 h-6 bg-(--k-color-primary) rounded-full flex items-center justify-center\" data-kid=\"90\">\n        <i class=\"ti ti-link text-black text-xs\" data-kid=\"91\"></i>\n      </div>\n      <span class=\"text-xs font-bold uppercase tracking-widest\" data-kid=\"92\">Linklytics</span>\n    </div>\n    <div class=\"flex items-center gap-6\" data-kid=\"93\">\n      <a href=\"#\" class=\"text-[10px] font-bold uppercase tracking-widest text-(--k-color-on-surface-muted) hover:text-(--k-color-primary)\" data-kid=\"94\">Twitter</a>\n      <a href=\"#\" class=\"text-[10px] font-bold uppercase tracking-widest text-(--k-color-on-surface-muted) hover:text-(--k-color-primary)\" data-kid=\"95\">Github</a>\n      <a href=\"#\" class=\"text-[10px] font-bold uppercase tracking-widest text-(--k-color-on-surface-muted) hover:text-(--k-color-primary)\" data-kid=\"96\">Discord</a>\n    </div>\n    <div class=\"text-[10px] font-bold uppercase tracking-widest text-(--k-color-on-surface-muted) border-l border-(--k-color-border) pl-6\" data-kid=\"97\">\n      v1.2.0-Alpha\n    </div>\n  </footer>\n</div>",
