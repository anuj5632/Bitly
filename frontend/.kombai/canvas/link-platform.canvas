olute top-2 right-2 w-1.5 h-1.5 rounded-full bg-[#318CE7]\" data-kid=\"46\"></span>\n        </button>\n        <img src=\"https://i.pravatar.cc/64?u=dorian\" alt=\"Dorian Vale avatar\" decoding=\"async\" loading=\"lazy\" class=\"w-9 h-9 rounded-full ring-1 ring-white/10\" data-kid=\"47\">\n      </div>\n    </header>\n\n    \n    <main class=\"lp-grid-bg flex-1 px-7 py-7\" data-kid=\"48\">\n\n      \n      <div class=\"flex items-end justify-between gap-4 mb-6\" data-kid=\"49\">\n        <div data-kid=\"50\">\n          <h2 class=\"text-[26px] font-bold tracking-tight\" data-kid=\"51\">All Links</h2>\n          <p class=\"text-[13px] text-[#A3A3A3] mt-1\" data-kid=\"52\">Manage, track and optimize every short link in your workspace.</p>\n        </div>\n        <div class=\"flex items-center gap-2.5\" data-kid=\"53\">\n          <button class=\"flex items-center gap-2 text-[13px] font-medium text-[#E5E5E5] bg-white/5 border border-white/10 rounded-lg px-3.5 py-2.5 hover:bg-white/10 transition-colors\" data-kid=\"54\"><i class=\"ti ti-adjustments-horizontal text-[16px]\" data-kid=\"55\"></i>Filter</button>\n          <button class=\"flex items-center gap-2 text-[13px] font-medium text-[#E5E5E5] bg-white/5 border border-white/10 rounded-lg px-3.5 py-2.5 hover:bg-white/10 transition-colors\" data-kid=\"56\"><i class=\"ti ti-download text-[16px]\" data-kid=\"57\"></i>Export</button>\n          <button class=\"lp-btn-glow flex items-center gap-2 text-[13px] font-semibold text-white bg-[#318CE7] rounded-lg px-4 py-2.5 shadow-[0_0_18px_rgba(49,140,231,0.35)]\" data-kid=\"58\"><i class=\"ti ti-plus text-[16px]\" data-kid=\"59\"></i>Create Link</button>\n        </div>\n      </div>\n\n      \n      <div class=\"flex items-center justify-between gap-4 mb-4\" data-kid=\"60\">\n        <div class=\"flex items-center gap-1.5 bg-[#0E0E0E] border border-white/10 rounded-xl p-1\" data-kid=\"61\">\n          <button class=\"text-[13px] font-medium text-[#F5F5F5] bg-white/10 rounde