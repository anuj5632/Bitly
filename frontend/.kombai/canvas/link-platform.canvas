      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css');\n  .ff { font-family: 'Inter', sans-serif; }\n  .nav-item { transition: color .2s ease, background-color .2s ease; }\n  .nav-item:hover { background-color: rgba(255,255,255,0.04); color:#fff; }\n  .stat-card { transition: transform .3s cubic-bezier(.2,.7,.2,1), box-shadow .3s ease, border-color .3s ease; }\n  .stat-card:hover { transform: translateY(-3px); border-color: rgba(49,140,231,0.4); box-shadow: 0 18px 50px rgba(0,0,0,0.55), 0 0 0 1px rgba(49,140,231,0.08); }\n  .row-hover { transition: background-color .2s ease; }\n  .row-hover:hover { background-color: rgba(255,255,255,0.03); }\n  .seg { transition: all .2s ease; }\n  .glow-btn { transition: box-shadow .25s ease, transform .2s ease; }\n  .glow-btn:hover { box-shadow: 0 0 0 1px rgba(49,140,231,0.5), 0 10px 30px rgba(49,140,231,0.35); transform: translateY(-1px); }\n  .dot-grid { background-image: radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1px); background-size: 22px 22px; }\n</style>\n\n<div class=\"ff w-full min-w-[1440px] bg-[#050505] text-white flex\" data-kid=\"1\">\n\n  \n  <aside class=\"w-[240px] shrink-0 bg-[#0E0E0E] border-r border-white/10 flex flex-col min-h-[1180px]\" data-kid=\"2\">\n    <div class=\"px-6 h-[72px] flex items-center gap-2.5 border-b border-white/10\" data-kid=\"3\">\n      <div class=\"w-8 h-8 rounded-lg bg-gradient-to-br from-[#318CE7] to-[#6050DC] flex items-center justify-center shadow-[0_6px_18px_rgba(49,140,231,0.45)]\" data-kid=\"4\">\n        <i class=\"ti ti-link text-[18px] text-white\" data-kid=\"5\"></i>\n      </div>\n      <span class=\"text-[16px] font-700 tracking-tight\" data-kid=\"6\">Linkly</span>\n    </div>\n\n    <nav class=\"px-3 py-5 flex flex-col gap-1\" data-kid=\"7\">\n      <p class=\"px-3 pb-2 text-[11px] font-600 tracking-[0.12em] text-[#5e5e5e] uppercase\" data-kid=\"8\">Workspace</p>\n      <a class=\"nav-item relative flex items-center gap-3 px-3 py-2.5 rounded-lg bg-white/[0.04] text-white text-[14px] font-500\" data-kid=\"9\">\n        <span class=\"absolute left-0 top-1.5 bottom-1.5 w-[3px] rounded-full bg-gradient-to-b from-[#318CE7] to-[#6050DC]\" data-kid=\"10\"></span>\n        <i class=\"ti ti-layout-grid text-[18px] text-[#318CE7]\" data-kid=\"11\"></i> Dashboard\n      </a>\n      <a class=\"nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-[#A3A3A3] text-[14px] font-500\" data-kid=\"12\"><i class=\"ti ti-link text-[18px]\" data-kid=\"13\"></i> Links</a>\n      <a class=\"nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-[#A3A3A3] text-[14px] font-500\" data-kid=\"14\"><i class=\"ti ti-chart-histogram text-[18px]\" data-kid=\"15\"></i> Analytics</a>\n      <a class=\"nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-[#A3A3A3] text-[14px] font-500\" data-kid=\"16\"><i class=\"ti ti-qrcode text-[18px]\" data-kid=\"17\"></i> QR Codes</a>\n      <a class=\"nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-[#A3A3A3] text-[14px] font-500\" data-kid=\"18\"><i class=\"ti ti-users text-[18px]\" data-kid=\"19\"></i> Teams</a>\n      <a class=\"nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-[#A3A3A3] text-[14px] font-500\" data-kid=\"20\"><i class=\"ti ti-plug text-[18px]\" data-kid=\"21\"></i> Integrations</a>\n\n      <p class=\"px-3 pt-5 pb-2 text-[11px] font-600 tracking-[0.12em] text-[#5e5e5e] uppercase\" data-kid=\"22\">Account</p>\n      <a class=\"nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-[#A3A3A3] text-[14px] font-500\" data-kid=\"23\"><i class=\"ti ti-settings text-[18px]\" data-kid=\"24\"></i> Settings</a>\n    </nav>\n\n    <div class=\"mt-auto p-3\" data-kid=\"25\">\n      <div class=\"rounded-xl border border-white/10 bg-[#0a0a0a] p-3 relative overflow-hidden\" data-kid=\"26\">\n        <div class=\"absolute -right-8 -top-8 w-24 h-24 rounded-full bg-[#318CE7]/15 blur-2xl\" data-kid=\"27\"></div>\n        <p class=\"text-[12px] text-[#A3A3A3]\" data-kid=\"28\">Pro plan</p>\n        <div class=\"mt-2 flex items-center justify-between text-[11px] text-[#777]\" data-kid=\"29\"><span data-kid=\"30\">Clicks used</span><span class=\"text-white/80\" data-kid=\"31\">68%</span></div>\n        <div class=\"mt-1.5 h-1.5 rounded-full bg-white/10 overflow-hidden\" data-kid=\"32\"><div class=\"h-full w-[68%] rounded-full bg-gradient-to-r from-[#318CE7] to-[#6050DC]\" data-kid=\"33\"></div></div>\n        <button class=\"glow-btn mt-3 w-full rounded-lg bg-white/[0.06] border border-white/10 py-2 text-[12px] font-600 text-white\" data-kid=\"34\">Upgrade plan</button>\n      </div>\n      <div class=\"flex items-center gap-3 px-2 pt-3\" data-kid=\"35\">\n        <img src=\"https://i.pravatar.cc/64?u=elenavoss\" alt=\"Elena Voss avatar\" decoding=\"async\" loading=\"lazy\" class=\"w-8 h-8 rounded-full ring-1 ring-white/15\" data-kid=\"36\">\n        <div class=\"leading-tight\" data-kid=\"37\">\n          <p class=\"text-[13px] font-600\" data-kid=\"38\">Elena Voss</p>\n          <p class=\"text-[11px] text-[#777]\" data-kid=\"39\">elena@acme.co</p>\n        </div>\n        <i class=\"ti ti-dots-vertical ml-auto text-[#777]\" data-kid=\"40\"></i>\n      </div>\n    </div>\n  </aside>\n\n  \n  <main class=\"flex-1 min-w-0\" data-kid=\"41\">\n    \n    <header class=\"h-[72px] px-8 flex items-center justify-between border-b border-white/10 bg-[#050505]/80 dot-grid\" data-kid=\"42\">\n      <div data-kid=\"43\">\n        <h1 class=\"text-[20px] font-700 tracking-tight leading-none\" data-kid=\"44\">Dashboard</h1>\n        <p class=\"text-[12.5px] text-[#A3A3A3] mt-1\" data-kid=\"45\">Welcome back, Elena — here's your link performance.</p>\n      </div>\n      <div class=\"flex items-center gap-3\" data-kid=\"46\">\n        <div class=\"hidden md:flex items-center gap-2 w-[280px] h-10 px-3 rounded-lg bg-[#0E0E0E] border border-white/10 text-[#777]\" data-kid=\"47\">\n          <i class=\"ti ti-search text-[16px]\" data-kid=\"48\"></i>\n          <input placeholder=\"Search links, tags, campaigns…\" class=\"bg-transparent outline-none text-[13px] text-white placeholder:text-[#666] w-full\" data-kid=\"49\">\n          <span class=\"text-[11px] px-1.5 py-0.5 rounded bg-white/5 border border-white/10\" data-kid=\"50\">⌘K</span>\n        </div>\n        <button class=\"relative w-10 h-10 rounded-lg bg-[#0E0E0E] border border-white/10 flex items-center justify-center text-[#A3A3A3] hover:text-white transition\" data-kid=\"51\">\n          <i class=\"ti ti-bell text-[18px]\" data-kid=\"52\"></i>\n          <span class=\"absolute top-2 right-2.5 w-2 h-2 rounded-full bg-[#318CE7] ring-2 ring-[#050505]\" data-kid=\"53\"></span>\n        </button>\n        <button class=\"glow-btn h-10 px-4 rounded-lg bg-[#318CE7] text-white text-[13px] font-600 flex items-center gap-2\" data-kid=\"54\"><i class=\"ti ti-plus text-[16px]\" data-kid=\"55\"></i> Create link</button>\n      </div>\n    </header>\n\n    <div class=\"p-8 flex flex-col gap-6\" data-kid=\"56\">\n\n      \n      <section class=\"grid grid-cols-4 gap-5\" data-kid=\"57\">\n        \n        <div class=\"stat-card rounded-2xl border border-white/10 bg-[#0E0E0E] p-5\" data-kid=\"58\">\n          <div class=\"flex items-center justify-between\" data-kid=\"59\">\n            <span class=\"w-9 h-9 rounded-lg bg-white/[0.05] border border-white/10 flex items-center justify-center text-[#318CE7]\" data-kid=\"60\"><i class=\"ti ti-link text-[18px]\" data-kid=\"61\"></i></span>\n            <span class=\"text-[12px] font-600 text-[#34d399] flex items-center gap-1\" data-kid=\"62\"><i class=\"ti ti-trending-up text-[14px]\" data-kid=\"63\"></i> 12.4%</span>\n          </div>\n          <p class=\"mt-4 text-[13px] text-[#A3A3A3]\" data-kid=\"64\">Total Links</p>\n          <div class=\"flex items-end justify-between\" data-kid=\"65\">\n            <p class=\"text-[28px] font-800 tracking-tight leading-tight\" data-kid=\"66\">24,815</p>\n            <svg width=\"72\" height=\"32\" viewBox=\"0 0 72 32\" fill=\"none\" data-kid=\"67\"><polyline points=\"0,24 12,20 24,22 36,14 48,16 60,8 72,6\" stroke=\"#34d399\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"68\"></polyline></svg>\n          </div>\n        </div>\n        \n        <div class=\"stat-card rounded-2xl border border-white/10 bg-[#0E0E0E] p-5\" data-kid=\"69\">\n          <div class=\"flex items-center justify-between\" data-kid=\"70\">\n            <span class=\"w-9 h-9 rounded-lg bg-white/[0.05] border border-white/10 flex items-center justify-center text-[#6050DC]\" data-kid=\"71\"><i class=\"ti ti-pointer text-[18px]\" data-kid=\"72\"></i></span>\n            <span class=\"text-[12px] font-600 text-[#34d399] flex items-center gap-1\" data-kid=\"73\"><i class=\"ti ti-trending-up text-[14px]\" data-kid=\"74\"></i> 28.9%</span>\n          </div>\n          <p class=\"mt-4 text-[13px] text-[#A3A3A3]\" data-kid=\"75\">Total Clicks</p>\n          <div class=\"flex items-end justify-between\" data-kid=\"76\">\n            <p class=\"text-[28px] font-800 tracking-tight leading-tight\" data-kid=\"77\">1.92M</p>\n            <svg width=\"72\" height=\"32\" viewBox=\"0 0 72 32\" fill=\"none\" data-kid=\"78\"><polyline points=\"0,26 12,22 24,18 36,20 48,12 60,10 72,4\" stroke=\"#318CE7\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"79\"></polyline></svg>\n          </div>\n        </div>\n        \n        <div class=\"stat-card rounded-2xl border border-white/10 bg-[#0E0E0E] p-5\" data-kid=\"80\">\n          <div class=\"flex items-center justify-between\" data-kid=\"81\">\n            <span class=\"w-9 h-9 rounded-lg bg-white/[0.05] border border-white/10 flex items-center justify-center text-[#318CE7]\" data-kid=\"82\"><i class=\"ti ti-rocket text-[18px]\" data-kid=\"83\"></i></span>\n            <span class=\"text-[12px] font-600 text-[#34d399] flex items-center gap-1\" data-kid=\"84\"><i class=\"ti ti-trending-up text-[14px]\" data-kid=\"85\"></i> 4.1%</span>\n          </div>\n          <p class=\"mt-4 text-[13px] text-[#A3A3A3]\" data-kid=\"86\">Active Campaigns</p>\n          <div class=\"flex items-end justify-between\" data-kid=\"87\">\n            <p class=\"text-[28px] font-800 tracking-tight leading-tight\" data-kid=\"88\">37</p>\n            <svg width=\"72\" height=\"32\" viewBox=\"0 0 72 32\" fill=\"none\" data-kid=\"89\"><polyline points=\"0,18 12,16 24,18 36,12 48,14 60,12 72,9\" stroke=\"#34d399\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"90\"></polyline></svg>\n          </div>\n        </div>\n        \n        <div class=\"stat-card rounded-2xl border border-white/10 bg-[#0E0E0E] p-5\" data-kid=\"91\">\n          <div class=\"flex items-center justify-between\" data-kid=\"92\">\n            <span class=\"w-9 h-9 rounded-lg bg-white/[0.05] border border-white/10 flex items-center justify-center text-[#6050DC]\" data-kid=\"93\"><i class=\"ti ti-qrcode text-[18px]\" data-kid=\"94\"></i></span>\n            <span class=\"text-[12px] font-600 text-[#f87171] flex items-center gap-1\" data-kid=\"95\"><i class=\"ti ti-trending-down text-[14px]\" data-kid=\"96\"></i> 2.3%</span>\n          </div>\n          <p class=\"mt-4 text-[13px] text-[#A3A3A3]\" data-kid=\"97\">QR Codes Generated</p>\n          <div class=\"flex items-end justify-between\" data-kid=\"98\">\n            <p class=\"text-[28px] font-800 tracking-tight leading-tight\" data-kid=\"99\">5,204</p>\n            <svg width=\"72\" height=\"32\" viewBox=\"0 0 72 32\" fill=\"none\" data-kid=\"100\"><polyline points=\"0,8 12,12 24,10 36,16 48,14 60,20 72,22\" stroke=\"#f87171\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"101\"></polyline></svg>\n          </div>\n        </div>\n      </section>\n\n      \n      <section class=\"grid grid-cols-10 gap-6\" data-kid=\"102\">\n        \n        <div class=\"col-span-7 rounded-2xl border border-white/10 bg-[#0E0E0E] p-6\" data-kid=\"103\">\n          <div class=\"flex items-start justify-between\" data-kid=\"104\">\n            <div data-kid=\"105\">\n              <h2 class=\"text-[16px] font-700 tracking-tight\" data-kid=\"106\">Click Trends</h2>\n              <p class=\"text-[12.5px] text-[#A3A3A3] mt-1\" data-kid=\"107\">Total clicks across all active links</p>\n            </div>\n            <div class=\"flex items-center gap-1 p-1 rounded-lg bg-white/[0.04] border border-white/10 text-[12px]\" data-kid=\"108\">\n              <button class=\"seg px-3 py-1 rounded-md text-[#A3A3A3]\" data-kid=\"109\">24h</button>\n              <button class=\"seg px-3 py-1 rounded-md bg-[#318CE7] text-white font-600\" data-kid=\"110\">7d</button>\n              <button class=\"seg px-3 py-1 rounded-md text-[#A3A3A3]\" data-kid=\"111\">30d</button>\n              <button class=\"seg px-3 py-1 rounded-md text-[#A3A3A3]\" data-kid=\"112\">12m</button>\n            </div>\n          </div>\n\n          <div class=\"flex items-baseline gap-3 mt-5\" data-kid=\"113\">\n            <p class=\"text-[30px] font-800 tracking-tight\" data-kid=\"114\">486,209</p>\n            <span class=\"text-[12px] font-600 text-[#34d399] flex items-center gap-1\" data-kid=\"115\"><i class=\"ti ti-trending-up text-[14px]\" data-kid=\"116\"></i> 18.2% vs last week</span>\n          </div>\n\n          <div class=\"relative mt-4\" data-kid=\"117\">\n            <svg viewBox=\"0 0 760 280\" preserveAspectRatio=\"none\" class=\"w-full h-[280px]\" data-kid=\"118\">\n              <defs data-kid=\"119\">\n                <linearGradient id=\"area\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\" data-kid=\"120\">\n                  <stop offset=\"0%\" stop-color=\"#318CE7\" stop-opacity=\"0.35\" data-kid=\"121\"></stop>\n                  <stop offset=\"100%\" stop-color=\"#318CE7\" stop-opacity=\"0\" data-kid=\"122\"></stop>\n                </linearGradient>\n              </defs>\n              <line x1=\"0\" y1=\"60\" x2=\"760\" y2=\"60\" stroke=\"rgba(255,255,255,0.05)\" data-kid=\"123\"></line>\n              <line x1=\"0\" y1=\"120\" x2=\"760\" y2=\"120\" stroke=\"rgba(255,255,255,0.05)\" data-kid=\"124\"></line>\n              <line x1=\"0\" y1=\"180\" x2=\"760\" y2=\"180\" stroke=\"rgba(255,255,255,0.05)\" data-kid=\"125\"></line>\n              <line x1=\"0\" y1=\"240\" x2=\"760\" y2=\"240\" stroke=\"rgba(255,255,255,0.05)\" data-kid=\"126\"></line>\n              <path d=\"M0,210 C60,200 90,150 150,160 C210,170 240,110 300,120 C360,130 390,70 450,90 C510,108 540,60 600,70 C660,80 700,40 760,48 L760,280 L0,280 Z\" fill=\"url(#area)\" data-kid=\"127\"></path>\n              <path d=\"M0,210 C60,200 90,150 150,160 C210,170 240,110 300,120 C360,130 390,70 450,90 C510,108 540,60 600,70 C660,80 700,40 760,48\" fill=\"none\" stroke=\"#318CE7\" stroke-width=\"2.5\" stroke-linecap=\"round\" style=\"filter: drop-shadow(0 0 8px rgba(49,140,231,0.6));\" data-kid=\"128\"></path>\n              <circle cx=\"600\" cy=\"70\" r=\"4.5\" fill=\"#fff\" stroke=\"#318CE7\" stroke-width=\"2\" data-kid=\"129\"></circle>\n            </svg>\n            <div class=\"absolute top-2 left-[78%] -translate-x-1/2 px-2.5 py-1.5 rounded-lg bg-[#0a0a0a] border border-white/15 text-[11px] shadow-[0_8px_24px_rgba(0,0,0,0.6)]\" data-kid=\"130\">\n              <p class=\"text-[#A3A3A3]\" data-kid=\"131\">Sat, Mar 22</p><p class=\"font-700\" data-kid=\"132\">92,418 clicks</p>\n            </div>\n            <div class=\"flex justify-between text-[11px] text-[#666] mt-2 px-1\" data-kid=\"133\">\n              <span data-kid=\"134\">Mon</span><span data-kid=\"135\">Tue</span><span data-kid=\"136\">Wed</span><span data-kid=\"137\">Thu</span><span data-kid=\"138\">Fri</span><span data-kid=\"139\">Sat</span><span data-kid=\"140\">Sun</span>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"col-span-3 rounded-2xl border border-white/10 bg-[#0E0E0E] p-6 flex flex-col\" data-kid=\"141\">\n          <div class=\"flex items-center justify-between\" data-kid=\"142\">\n            <h2 class=\"text-[16px] font-700 tracking-tight\" data-kid=\"143\">Recent Activity</h2>\n            <i class=\"ti ti-arrow-up-right text-[#777]\" data-kid=\"144\"></i>\n          </div>\n          <div class=\"relative mt-5 pl-1\" data-kid=\"145\">\n            <div class=\"absolute left-[15px] top-2 bottom-2 w-px bg-white/10\" data-kid=\"146\"></div>\n            <div class=\"flex flex-col gap-5\" data-kid=\"147\">\n              <div class=\"relative flex gap-3\" data-kid=\"148\">\n                <span class=\"z-10 mt-0.5 w-[30px] h-[30px] rounded-full bg-[#0a0a0a] border border-white/10 flex items-center justify-center text-[#318CE7]\" data-kid=\"149\"><i class=\"ti ti-world text-[15px]\" data-kid=\"150\"></i></span>\n                <div data-kid=\"151\"><p class=\"text-[13px] text-[#E5E5E5] leading-snug\" data-kid=\"152\"><span class=\"font-600 text-white\" data-kid=\"153\">acme.co/launch</span> clicked in <span class=\"text-white\" data-kid=\"154\">Germany</span></p><p class=\"text-[11px] text-[#777] mt-0.5\" data-kid=\"155\">2 min ago</p></div>\n              </div>\n              <div class=\"relative flex gap-3\" data-kid=\"156\">\n                <img src=\"https://i.pravatar.cc/64?u=marcus\" alt=\"Marcus avatar\" decoding=\"async\" loading=\"lazy\" class=\"z-10 w-[30px] h-[30px] rounded-full ring-1 ring-white/15\" data-kid=\"157\">\n                <div data-kid=\"158\"><p class=\"text-[13px] text-[#E5E5E5] leading-snug\" data-kid=\"159\"><span class=\"font-600 text-white\" data-kid=\"160\">Marcus L.</span> created a new branded link</p><p class=\"text-[11px] text-[#777] mt-0.5\" data-kid=\"161\">18 min ago</p></div>\n              </div>\n              <div class=\"relative flex gap-3\" data-kid=\"162\">\n                <span class=\"z-10 mt-0.5 w-[30px] h-[30px] rounded-full bg-[#0a0a0a] border border-white/10 flex items-center justify-center text-[#6050DC]\" data-kid=\"163\"><i class=\"ti ti-qrcode text-[15px]\" data-kid=\"164\"></i></span>\n                <div data-kid=\"165\"><p class=\"text-[13px] text-[#E5E5E5] leading-snug\" data-kid=\"166\">QR code generated for <span class=\"font-600 text-white\" data-kid=\"167\">spring-sale</span></p><p class=\"text-[11px] text-[#777] mt-0.5\" data-kid=\"168\">41 min ago</p></div>\n              </div>\n              <div class=\"relative flex gap-3\" data-kid=\"169\">\n                <span class=\"z-10 mt-0.5 w-[30px] h-[30px] rounded-full bg-[#0a0a0a] border border-white/10 flex items-center justify-center text-[#34d399]\" data-kid=\"170\"><i class=\"ti ti-flame text-[15px]\" data-kid=\"171\"></i></span>\n                <div data-kid=\"172\"><p class=\"text-[13px] text-[#E5E5E5] leading-snug\" data-kid=\"173\"><span class=\"font-600 text-white\" data-kid=\"174\">go.acme/webinar</span> hit <span class=\"text-white\" data-kid=\"175\">10k clicks</span></p><p class=\"text-[11px] text-[#777] mt-0.5\" data-kid=\"176\">1 hr ago</p></div>\n              </div>\n              <div class=\"relative flex gap-3\" data-kid=\"177\">\n                <img src=\"https://i.pravatar.cc/64?u=sara\" alt=\"Sara avatar\" decoding=\"async\" loading=\"lazy\" class=\"z-10 w-[30px] h-[30px] rounded-full ring-1 ring-white/15\" data-kid=\"178\">\n                <div data-kid=\"179\"><p class=\"text-[13px] text-[#E5E5E5] leading-snug\" data-kid=\"180\"><span class=\"font-600 text-white\" data-kid=\"181\">Sara K.</span> joined the Marketing team</p><p class=\"text-[11px] text-[#777] mt-0.5\" data-kid=\"182\">3 hr ago</p></div>\n              </div>\n            </div>\n          </div>\n          <button class=\"mt-auto pt-5 text-[12.5px] font-600 text-[#318CE7] hover:text-white transition text-left\" data-kid=\"183\">View all activity →</button>\n        </div>\n      </section>\n\n      \n      <section class=\"rounded-2xl border border-white/10 bg-[#0E0E0E] overflow-hidden\" data-kid=\"184\">\n        <div class=\"flex items-center justify-between px-6 py-4 border-b border-white/10\" data-kid=\"185\">\n          <div data-kid=\"186\">\n            <h2 class=\"text-[16px] font-700 tracking-tight\" data-kid=\"187\">Top Performing Links</h2>\n            <p class=\"text-[12.5px] text-[#A3A3A3] mt-0.5\" data-kid=\"188\">Ranked by clicks over the last 7 days</p>\n          </div>\n          <button class=\"text-[12.5px] font-600 text-[#A3A3A3] hover:text-white transition flex items-center gap-1.5 px-3 py-2 rounded-lg border border-white/10 bg-white/[0.03]\" data-kid=\"189\">View all links <i class=\"ti ti-chevron-right text-[14px]\" data-kid=\"190\"></i></button>\n        </div>\n        <table class=\"w-full text-left\" data-kid=\"191\">\n          <thead data-kid=\"192\">\n            <tr class=\"text-[11px] uppercase tracking-[0.1em] text-[#666]\" data-kid=\"193\">\n              <th class=\"font-600 px-6 py-3\" data-kid=\"194\">Link</th>\n              <th class=\"font-600 px-6 py-3\" data-kid=\"195\">Destination</th>\n              <th class=\"font-600 px-6 py-3 w-[220px]\" data-kid=\"196\">Clicks</th>\n              <th class=\"font-600 px-6 py-3\" data-kid=\"197\">CTR</th>\n              <th class=\"font-600 px-6 py-3\" data-kid=\"198\">Status</th>\n            </tr>\n          </thead>\n          <tbody class=\"text-[13px]\" data-kid=\"199\">\n            <tr class=\"row-hover border-t border-white/[0.06]\" data-kid=\"200\">\n              <td class=\"px-6 py-4\" data-kid=\"201\"><p class=\"font-600 text-white\" data-kid=\"202\">Spring Launch</p><p class=\"text-[#318CE7] text-[12px]\" data-kid=\"203\">linkly.io/launch</p></td>\n              <td class=\"px-6 py-4 text-[#