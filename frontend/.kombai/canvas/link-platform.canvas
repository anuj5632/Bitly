      "html": "<style data-kid=\"0\">\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.24.0/dist/tabler-icons.min.css');\n\n.lp-root { font-family: 'Inter', sans-serif; }\n.lp-grid-bg {\n  background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.04) 1px, transparent 0);\n  background-size: 32px 32px;\n}\n.row-actions { opacity: 0; transform: translateX(6px); transition: all .25s ease; }\n.lp-row:hover .row-actions { opacity: 1; transform: translateX(0); }\n.lp-row { transition: background-color .25s ease, box-shadow .25s ease; }\n.lp-row:hover { background-color: #0E0E0E; box-shadow: inset 3px 0 0 0 #318CE7; }\n.lp-nav { transition: all .2s ease; }\n.lp-nav:hover { background-color: rgba(255,255,255,0.04); color: #F5F5F5; }\n.lp-btn-glow { transition: all .25s ease; }\n.lp-btn-glow:hover { box-shadow: 0 0 24px rgba(49,140,231,0.45); transform: translateY(-1px); }\n.lp-copy { transition: color .2s ease; }\n.lp-copy:hover { color: #318CE7; }\n</style>\n\n<div class=\"lp-root bg-[#050505] text-[#F5F5F5] min-h-[1020px] flex selection:bg-[#318CE7]/30\" data-kid=\"1\">\n\n  \n  <aside class=\"w-[240px] shrink-0 bg-[#0E0E0E] border-r border-white/10 flex flex-col min-h-[1020px]\" data-kid=\"2\">\n    <div class=\"px-5 h-[68px] flex items-center gap-2.5 border-b border-white/10\" data-kid=\"3\">\n      <div class=\"w-8 h-8 rounded-lg bg-gradient-to-br from-[#318CE7] to-[#6050DC] flex items-center justify-center shadow-[0_0_20px_rgba(49,140,231,0.4)]\" data-kid=\"4\">\n        <i class=\"ti ti-link text-white text-[18px]\" data-kid=\"5\"></i>\n      </div>\n      <span class=\"text-[16px] font-bold tracking-tight\" data-kid=\"6\">Linkly</span>\n      <span class=\"ml-auto text-[10px] font-semibold text-[#A3A3A3] border border-white/10 rounded px-1.5 py-0.5\" data-kid=\"7\">PRO</span>\n    </div>\n\n    <nav class=\"flex-1 px-3 py-5 space-y-1 text-[14px]\" data-kid=\"8\">\n      <p class=\"px-3 pb-2 text-[11px] font-semibold tracking-wider text-[#5A5A5A] uppercase\" data-kid=\"9\">Workspace</p>\n      <a class=\"lp-nav flex items-center gap-3 px-3 py-2.5 rounded-lg text-[#A3A3A3]\" data-kid=\"10\"><i class=\"ti ti-layout-dashboard text-[18px]\" data-kid=\"11\"></i>Dashboard</a>\n      <a class=\"relative flex items-center gap-3 px-3 py-2.5 rounded-lg bg-white/5 text-[#F5F5F5] font-medium\" data-kid=\"12\">\n        <span class=\"absolute left-0 top-1.5 bottom-1.5 w-[3px] rounded-full bg-[#318CE7]\" data-kid=\"13\"></span>\n        <i class=\"ti ti-link text-[18px] text-[#318CE7]\" data-kid=\"14\"></i>Links\n        <span class=\"ml-auto text-[11px] text-[#A3A3A3] bg-white/5 rounded px-1.5 py-0.5\" data-kid=\"15\">128</span>\n      </a>\n      <a class=\"lp-nav flex items-center gap-3 px-3 py-2.5 rounded-lg text-[#A3A3A3]\" data-kid=\"16\"><i class=\"ti ti-chart-dots-2 text-[18px]\" data-kid=\"17\"></i>Analytics</a>\n      <a class=\"lp-nav flex items-center gap-3 px-3 py-2.5 rounded-lg text-[#A3A3A3]\" data-kid=\"18\"><i class=\"ti ti-qrcode text-[18px]\" data-kid=\"19\"></i>QR Codes</a>\n      <a class=\"lp-nav flex items-center gap-3 px-3 py-2.5 rounded-lg text-[#A3A3A3]\" data-kid=\"20\"><i class=\"ti ti-users text-[18px]\" data-kid=\"21\"></i>Teams</a>\n      <a class=\"lp-nav flex items-center gap-3 px-3 py-2.5 rounded-lg text-[#A3A3A3]\" data-kid=\"22\"><i class=\"ti ti-plug-connected text-[18px]\" data-kid=\"23\"></i>Integrations</a>\n      <a class=\"lp-nav flex items-center gap-3 px-3 py-2.5 rounded-lg text-[#A3A3A3]\" data-kid=\"24\"><i class=\"ti ti-settings text-[18px]\" data-kid=\"25\"></i>Settings</a>\n    </nav>\n\n    <div class=\"mx-3 mb-3 rounded-xl border border-white/10 bg-gradient-to-br from-[#318CE7]/10 to-[#6050DC]/10 p-4\" data-kid=\"26\">\n      <p class=\"text-[13px] font-semibold\" data-kid=\"27\">Upgrade workspace</p>\n      <p class=\"text-[11px] text-[#A3A3A3] mt-1 leading-r