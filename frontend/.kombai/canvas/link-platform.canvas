      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .lp-root { font-family: 'Inter', sans-serif; background-color: #050505; color: #F5F5F5; }\n  .lp-mono { font-family: 'JetBrains Mono', monospace; }\n  .lp-dotgrid {\n    background-image: radial-gradient(rgba(255,255,255,0.045) 1px, transparent 1px);\n    background-size: 26px 26px;\n  }\n  .lp-gridlines {\n    background-image:\n      linear-gradient(to right, rgba(255,255,255,0.035) 1px, transparent 1px),\n      linear-gradient(to bottom, rgba(255,255,255,0.035) 1px, transparent 1px);\n    background-size: 64px 64px;\n  }\n  .lp-glass { background: rgba(255,255,255,0.04); backdrop-filter: blur(14px); border: 1px solid rgba(255,255,255,0.08); }\n  .lp-float-a { animation: lpFloatA 7s ease-in-out infinite; }\n  .lp-float-b { animation: lpFloatB 8.5s ease-in-out infinite; }\n  @keyframes lpFloatA { 0%,100% { transform: translateY(0) rotate(-6deg); } 50% { transform: translateY(-14px) rotate(-6deg); } }\n  @keyframes lpFloatB { 0%,100% { transform: translateY(0) rotate(5deg); } 50% { transform: translateY(-18px) rotate(5deg); } }\n  .lp-feature { transition: transform .35s cubic-bezier(.2,.7,.2,1), border-color .35s, box-shadow .35s, background .35s; }\n  .lp-feature:hover { transform: translateY(-6px); border-color: rgba(49,140,231,0.5); box-shadow: 0 0 0 1px rgba(49,140,231,0.15), 0 24px 60px -20px rgba(49,140,231,0.25); background: rgba(49,140,231,0.04); }\n  .lp-btn-glow { transition: transform .25s, box-shadow .35s; box-shadow: 0 0 0 1px rgba(49,140,231,0.4), 0 10px 30px -8px rgba(49,140,231,0.55); }\n  .lp-btn-glow:hover { transform: translateY(-2px); box-shadow: 0 0 0 1px rgba(49,140,231,0.7), 0 14px 44px -8px rgba(49,140,231,0.8); }\n  .lp-link { transition: color .2s; }\n  .lp-link:hover { color: #fff; }\n  .lp-price { transition: transform .35s, border-color .35s; }\n  .lp-price:hover { transform: translateY(-4px); }\n  .lp-pulse { animation: lpPulse 2.4s ease-in-out infinite; }\n  @keyframes lpPulse { 0%,100% { opacity: 1; } 50% { opacity: .35; } }\n</style>\n\n<div class=\"lp-root relative w-full overflow-hidden antialiased\" data-kid=\"1\">\n\n  \n  <div class=\"pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 w-[900px] h-[900px] rounded-full blur-[160px] opacity-[0.22]\" style=\"background: radial-gradient(circle, #6050DC 0%, transparent 60%);\" data-kid=\"2\"></div>\n  <div class=\"pointer-events-none absolute top-[700px] -left-40 w-[600px] h-[600px] rounded-full blur-[150px] opacity-[0.16]\" style=\"background: radial-gradient(circle, #318CE7 0%, transparent 60%);\" data-kid=\"3\"></div>\n\n  \n  <header class=\"relative z-30 max-w-[1280px] mx-auto px-8 pt-7\" data-kid=\"4\">\n    <div class=\"lp-glass rounded-2xl px-5 py-3 flex items-center justify-between\" data-kid=\"5\">\n      <div class=\"flex items-center gap-9\" data-kid=\"6\">\n        <div class=\"flex items-center gap-2.5\" data-kid=\"7\">\n          <div class=\"w-8 h-8 rounded-lg flex items-center justify-center text-[18px] text-white\" style=\"background: linear-gradient(135deg,#318CE7,#6050DC); box-shadow: 0 6px 20px -6px rgba(49,140,231,0.7);\" data-kid=\"8\"><i class=\"ti ti-link\" data-kid=\"9\"></i></div>\n          <span class=\"text-[17px] font-bold tracking-tight\" data-kid=\"10\">Linkforge</span>\n        </div>\n        <nav class=\"hidden md:flex items-center gap-7 text-[14px] text-[#A3A3A3]\" data-kid=\"11\">\n          <a href=\"#\" class=\"lp-link\" data-kid=\"12\">Features</a>\n          <a href=\"#\" class=\"lp-link\" data-kid=\"13\">Analytics</a>\n          <a href=\"#\" class=\"lp-link\" data-kid=\"14\">Pricing</a>\n          <a href=\"#\" class=\"lp-link\" data-kid=\"15\">Docs</a>\n        </nav>\n      </div>\n      <div class=\"flex items-center gap-3\" data-kid=\"16\">\n        <a href=\"#\" class=\"hidden sm:inline text-[14px] text-[#E5E5E5] px-4 py-2 rounded-lg lp-link\" data-kid=\"17\">Sign in</a>\n        <a href=\"#\" class=\"text-[14px] font-semibold text-white px-4 py-2 rounded-lg lp-btn-glow\" style=\"background: linear-gradient(135deg,#318CE7,#2563c9);\" data-kid=\"18\">Start Free</a>\n      </div>\n    </div>\n  </header>\n\n  \n  <section class=\"relative z-10 lp-dotgrid\" data-kid=\"19\">\n    <div class=\"max-w-[1280px] mx-auto px-8 pt-24 pb-16 text-center relative\" data-kid=\"20\">\n      <div class=\"inline-flex items-center gap-2 lp-glass rounded-full pl-2 pr-4 py-1.5 mb-8 text-[12.5px] text-[#C9C9C9]\" data-kid=\"21\">\n        <span class=\"lp-mono text-[10px] font-semibold px-2 py-0.5 rounded-full text-white\" style=\"background: linear-gradient(135deg,#6050DC,#318CE7);\" data-kid=\"22\">NEW</span>\n        Link intelligence, now with AI insights\n        <i class=\"ti ti-arrow-right text-[14px] text-[#8a8a8a]\" data-kid=\"23\"></i>\n      </div>\n\n      <h1 class=\"text-[80px] leading-[0.98] font-extrabold tracking-[-0.04em] text-white\" data-kid=\"24\">\n        Short Links.<br data-kid=\"25\">Smarter Growth.\n      </h1>\n      <p class=\"max-w-[640px] mx-auto mt-7 text-[19px] leading-relaxed text-[#A3A3A3]\" data-kid=\"26\">\n        Transform long URLs into powerful marketing assets with real-time analytics, branded links, and actionable insights — built for teams that move fast.\n      </p>\n\n      \n      <div class=\"max-w-[620px] mx-auto mt-10\" data-kid=\"27\">\n        <div class=\"lp-glass rounded-2xl p-2 flex items-center gap-2\" style=\"box-shadow: 0 20px 60px -20px rgba(49,140,231,0.35);\" data-kid=\"28\">\n          <span class=\"pl-3 text-[#6e6e6e] text-[18px]\" data-kid=\"29\"><i class=\"ti ti-world\" data-kid=\"30\"></i></span>\n          <input type=\"text\" value=\"https://yourcompany.com/spring-campaign/launch-2026\" class=\"lp-mono flex-1 bg-transparent outline-none text-[14px] text-[#E5E5E5] placeholder:text-[#5a5a5a]\" data-kid=\"31\">\n          <button class=\"text-[14px] font-semibold text-white px-5 py-3 rounded-xl lp-btn-glow flex items-center gap-2 shrink-0\" style=\"background: linear-gradient(135deg,#318CE7,#2563c9);\" data-kid=\"32\">Shorten <i class=\"ti ti-bolt text-[15px]\" data-kid=\"33\"></i></button>\n        </div>\n        <div class=\"flex items-center justify-center gap-6 mt-4 text-[12.5px] text-[#6e6e6e]\" data-kid=\"34\">\n          <span class=\"flex items-center gap-1.5\" data-kid=\"35\"><i class=\"ti ti-check text-[#318CE7]\" data-kid=\"36\"></i> No credit card</span>\n          <span class=\"flex items-center gap-1.5\" data-kid=\"37\"><i class=\"ti ti-check text-[#318CE7]\" data-kid=\"38\"></i> Free forever plan</span>\n          <span class=\"flex items-center gap-1.5\" data-kid=\"39\"><i class=\"ti ti-check text-[#318CE7]\" data-kid=\"40\"></i> 99.99% uptime</span>\n        </div>\n      </div>\n\n      \n      <div class=\"relative max-w-[1000px] mx-auto mt-20\" data-kid=\"41\">\n\n        \n        <div class=\"lp-glass lp-float-a absolute -left-10 top-[240px] z-20 rounded-2xl p-4 w-[190px] text-left hidden lg:block\" style=\"box-shadow: 0 24px 60px -24px rgba(49,140,231,0.5);\" data-kid=\"42\">\n          <div class=\"flex items-center justify-between\" data-kid=\"43\">\n            <span class=\"text-[11px] text-[#9a9a9a]\" data-kid=\"44\">Clicks today</span>\n            <span class=\"text-[#37d39b] text-[16px]\" data-kid=\"45\"><i class=\"ti ti-trending-up\" data-kid=\"46\"></i></span>\n          </div>\n          <div class=\"text-[26px] font-bold text-white mt-1\" data-kid=\"47\">12,480</div>\n          <div class=\"text-[11px] text-[#37d39b] font-medium mt-0.5\" data-kid=\"48\">+24% vs yesterday</div>\n          <svg viewBox=\"0 0 160 40\" class=\"w-full h-9 mt-2\" data-kid=\"49\"></svg>\n        </div>\n\n        \n        <div class=\"lp-glass lp-float-b absolute -right-4 top-40 z-20 rounded-2xl p-4 w-[180px] text-left hidden lg:block\" style=\"box-shadow: 0 24px 60px -24px rgba(96,80,220,0.5);\" data-kid=\"51\">\n          <div class=\"flex items-center gap-2 mb-2\" data-kid=\"52\">\n            <span class=\"w-2 h-2 rounded-full bg-[#318CE7] lp-pulse\" data-kid=\"53\"></span>\n            <span class=\"text-[11px] text-[#9a9a9a]\" data-kid=\"54\">Live now</span>\n          </div>\n          <div class=\"text-[13px] text-white font-semibold flex items-center gap-2\" data-kid=\"55\"><i class=\"ti ti-map-pin text-[#6050DC]\" data-kid=\"56\"></i> Berlin, DE</div>\n          <div class=\"text-[13px] text-white font-semibold flex items-center gap-2 mt-1.5\" data-kid=\"57\"><i class=\"ti ti-map-pin text-[#318CE7]\" data-kid=\"58\"></i> Austin, US</div>\n          <div class=\"text-[13px] text-white font-semibold flex items-center gap-2 mt-1.5\" data-kid=\"59\"><i class=\"ti ti-map-pin text-[#37d39b]\" data-kid=\"60\"></i> Tokyo, JP</div>\n        </div>\n\n        \n        <div class=\"rounded-3xl overflow-hidden border border-white/10 bg-[#0A0A0A]\" style=\"box-shadow: 0 60px 140px -40px rgba(0,0,0,0.9), 0 0 0 1px rgba(255,255,255,0.04);\" data-kid=\"61\">\n          <div class=\"flex items-center gap-2 px-4 py-3 border-b border-white/8 bg-[#0E0E0E]\" data-kid=\"62\">\n            <span class=\"w-3 h-3 rounded-full bg-[#ff5f57]\" data-kid=\"63\"></span>\n            <span class=\"w-3 h-3 rounded-full bg-[#febc2e]\" data-kid=\"64\"></span>\n            <span class=\"w-3 h-3 rounded-full bg-[#28c840]\" data-kid=\"65\"></span>\n            <div class=\"lp-mono mx-auto text-[11px] text-[#6e6e6e] bg-[#070707] px-4 py-1 rounded-md border border-white/5\" data-kid=\"66\">app.linkforge.io/analytics</div>\n          </div>\n          <div class=\"p-6 text-left lp-gridlines\" data-kid=\"67\">\n            <div class=\"flex items-center justify-between mb-5\" data-kid=\"68\">\n              <div data-kid=\"69\">\n                <div class=\"text-[12px] text-[#8a8a8a]\" data-kid=\"70\">Total clicks · last 30 days</div>\n                <div class=\"text-[32px] font-bold text-white tracking-tight\" data-kid=\"71\">1,284,920</div>\n              </div>\n              <div class=\"flex gap-2\" data-kid=\"72\">\n                <span class=\"text-[11px] px-3 py-1.5 rounded-lg bg-white/5 text-[#cfcfcf] border border-white/8\" data-kid=\"73\">7D</span>\n                <span class=\"text-[11px] px-3 py-1.5 rounded-lg text-white border border-[#318CE7]/40\" style=\"background: rgba(49,140,231,0.12);\" data-kid=\"74\">30D</span>\n                <span class=\"text-[11px] px-3 py-1.5 rounded-lg bg-white/5 text-[#cfcfcf] border border-white/8\" data-kid=\"75\">90D</span>\n              </div>\n            </div>\n            <svg viewBox=\"0 0 900 260\" class=\"w-full h-[230px]\" preserveAspectRatio=\"none\" data-kid=\"76\"></svg>\n            <div class=\"grid grid-cols-4 gap-3 mt-5\" data-kid=\"84\">\n              <div class=\"rounded-xl border border-white/8 bg-white/[0.02] p-3\" data-kid=\"85\"><div class=\"text-[11px] text-[#8a8a8a]\" data-kid=\"86\">Top country</div><div class=\"text-[14px] font-semibold text-white mt-1\" data-kid=\"87\">United States</div></div>\n              <div class=\"rounded-xl border border-white/8 bg-white/[0.02] p-3\" data-kid=\"88\"><div class=\"text-[11px] text-[#8a8a8a]\" data-kid=\"89\">Devices</div><div class=\"text-[14px] font-semibold text-white mt-1\" data-kid=\"90\">68% Mobile</div></div>\n              <div class=\"rounded-xl border border-white/8 bg-white/[0.02] p-3\" data-kid=\"91\"><div class=\"text-[11px] text-[#8a8a8a]\" data-kid=\"92\">CTR</div><div class=\"text-[14px] font-semibold text-white mt-1\" data-kid=\"93\">7.4%</div></div>\n              <div class=\"rounded-xl border border-white/8 bg-white/[0.02] p-3\" data-kid=\"94\"><div class=\"text-[11px] text-[#8a8a8a]\" data-kid=\"95\">Referrer</div><div class=\"text-[14px] font-semibold text-white mt-1\" data-kid=\"96\">Instagram</div></div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"relative z-10 max-w-[1280px] mx-auto px-8 py-20\" data-kid=\"97\">\n    <p class=\"text-center text-[12px] uppercase tracking-[0.25em] text-[#6e6e6e] mb-10\" data-kid=\"98\">Trusted by creators, startups &amp; global teams</p>\n    <div class=\"grid grid-cols-2 md:grid-cols-4 gap-5\" data-kid=\"99\">\n      <div class=\"lp-glass rounded-2xl p-6 text-center\" style=\"box-shadow: 0 20px 50px -30px rgba(49,140,231,0.5);\" data-kid=\"100\"><div class=\"text-[40px] font-extrabold text-white tracking-tight\" data-kid=\"101\">10B+</div><div class=\"text-[13px] text-[#9a9a9a] mt-1\" data-kid=\"102\">Links shortened</div></div>\n      <div class=\"lp-glass rounded-2xl p-6 text-center\" style=\"box-shadow: 0 20px 50px -30px rgba(96,80,220,0.5);\" data-kid=\"103\"><div class=\"text-[40px] font-extrabold text-white tracking-tight\" data-kid=\"104\">50B+</div><div class=\"text-[13px] text-[#9a9a9a] mt-1\" data-kid=\"105\">Clicks tracked</div></div>\n      <div class=\"lp-glass rounded-2xl p-6 text-center\" style=\"box-shadow: 0 20px 50px -30px rgba(49,140,231,0.5);\" data-kid=\"106\"><div class=\"text-[40px] font-extrabold text-white tracking-tight\" data-kid=\"107\">2M+</div><div class=\"text-[13px] text-[#9a9a9a] mt-1\" data-kid=\"108\">Active users</div></div>\n      <div class=\"lp-glass rounded-2xl p-6 text-center\" style=\"box-shadow: 0 20px 50px -30px rgba(96,80,220,0.5);\" data-kid=\"109\"><div class=\"text-[40px] font-extrabold text-white tracking-tight\" data-kid=\"110\">190+</div><div class=\"text-[13px] text-[#9a9a9a] mt-1\" data-kid=\"111\">Countries reached</div></div>\n    </div>\n  </section>\n\n  \n  <section class=\"relative z-10 max-w-[1280px] mx-auto px-8 py-20\" data-kid=\"112\">\n    <div class=\"max-w-[620px] mb-12\" data-kid=\"113\">\n      <h2 class=\"text-[44px] font-bold tracking-[-0.03em] text-white leading-tight\" data-kid=\"114\">Everything you need to<br data-kid=\"115\">own every link.</h2>\n      <p class=\"text-[16px] text-[#A3A3A3] mt-4\" data-kid=\"116\">A complete toolkit for shortening, branding, and understanding every link you share.</p>\n    </div>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-5\" data-kid=\"117\">\n      \n      <div class=\"lp-feature md:col-span-2 rounded-3xl border border-white/8 bg-[#0A0A0A] p-7 flex flex-col justify-between min-h-[280px]\" data-kid=\"118\">\n        <div data-kid=\"119\">\n          <div class=\"flex items-center gap-3\" data-kid=\"120\">\n            <span class=\"w-10 h-10 rounded-xl flex items-center justify-center text-[20px] text-[#318CE7]\" style=\"background: rgba(49,140,231,0.12);\" data-kid=\"121\"><i class=\"ti ti-chart-histogram\" data-kid=\"122\"></i></span>\n            <h3 class=\"text-[20px] font-semibold text-white\" data-kid=\"123\">Real-Time Analytics</h3>\n          </div>\n          <p class=\"text-[14px] text-[#9a9a9a] mt-3 max-w-[420px]\" data-kid=\"124\">Watch clicks land the moment they happen. Track trends, sources, devices, and geography with millisecond precision.</p>\n        </div>\n        <svg viewBox=\"0 0 700 120\" class=\"w-full h-[110px] mt-4\" preserveAspectRatio=\"none\" data-kid=\"125\"></svg>\n      </div>\n\n      <div class=\"lp-feature rounded-3xl border border-white/8 bg-[#0A0A0A] p-7 min-h-[280px] flex flex-col\" data-kid=\"132\">\n        <span class=\"w-10 h-10 rounded-xl flex items-center justify-center text-[20px] text-[#37d39b]\" style=\"background: rgba(55,211,155,0.12);\" data-kid=\"133\"><i class=\"ti ti-bolt\" data-kid=\"134\"></i></span>\n        <h3 class=\"text-[18px] font-semibold text-white mt-4\" data-kid=\"135\">Instant Shortening</h3>\n        <p class=\"text-[13.5px] text-[#9a9a9a] mt-2\" data-kid=\"136\">Generate clean, reliable short links in milliseconds at any scale.</p>\n        <div class=\"mt-auto lp-mono text-[12px] text-[#cfcfcf] bg-black/40 border border-white/8 rounded-lg px-3 py-2\" data-kid=\"137\">lnkf.io/<span class=\"text-[#318CE7]\" data-kid=\"138\">launch</span></div>\n      </div>\n\n      <div class=\"lp-feature rounded-3xl border border-white/8 bg-[#0A0A0A] p-7 min-h-[220px] flex flex-col\" data-kid=\"139\">\n        <span class=\"w-10 h-10 rounded-xl flex items-center justify-center text-[20px] text-[#318CE7]\" style=\"background: rgba(49,140,231,0.12);\" data-kid=\"140\"><i class=\"ti ti-pencil\" data-kid=\"141\"></i></span>\n        <h3 class=\"text-[18px] font-semibold text-white mt-4\" data-kid=\"142\">Custom Aliases</h3>\n        <p class=\"text-[13.5px] text-[#9a9a9a] mt-2\" data-kid=\"143\">Craft memorable, on-brand slugs that people actually trust and click.</p>\n      </div>\n\n      <div class=\"lp-feature rounded-3xl border border-white/8 bg-[#0A0A0A] p-7 min-h-[220px] flex flex-col\" data-kid=\"144\">\n        <span class=\"w-10 h-10 rounded-xl flex items-center justify-center text-[20px] text-[#6050DC]\" style=\"background: rgba(96,80,220,0.12);\" data-kid=\"145\"><i class=\"ti ti-world\" data-kid=\"146\"></i></span>\n        <h3 class=\"text-[18px] font-semibold text-white mt-4\" data-kid=\"147\">Branded Domains</h3>\n        <p class=\"text-[13.5px] text-[#9a9a9a] mt-2\" data-kid=\"148\">Bring your own domain and ship links that reinforce your brand everywhere.</p>\n      </div>\n\n      <div class=\"lp-feature rounded-3xl border border-white/8 bg-[#0A0A0A] p-7 min-h-[220px] flex flex-col items-start\" data-kid=\"149\">\n        <span class=\"w-10 h-10 rounded-xl flex items-center justify-center text-[20px] text-[#37d39b]\" style=\"background: rgba(55,211,155,0.12);\" data-kid=\"150\"><i class=\"ti ti-qrcode\" data-kid=\"151\"></i></span>\n        <h3 class=\"text-[18px] font-semibold text-white mt-4\" data-kid=\"152\">QR Code Generation</h3>\n        <p class=\"text-[13.5px] text-[#9a9a9a] mt-2\" data-kid=\"153\">Dynamic, trackable QR codes for every link — print to pixel, fully measurable.</p>\n      </div>\n\n      \n      <div class=\"lp-feature rounded-3xl border border-white/8 bg-[#0A0A0A] p-7 min-h-[160px] flex items-center gap-4\" data-kid=\"154\">\n        <span class=\"w-11 h-11 rounded-xl flex items-center justify-center text-[20px] text-[#318CE7] shrink-0\" style=\"background: rgba(49,140,231,0.12);\" data-kid=\"155\"><i class=\"ti ti-route\" data-kid=\"156\"></i></span>\n        <div data-kid=\"157\"><h3 class=\"text-[16px] font-semibold text-white\" data-kid=\"158\">Traffic Insights</h3><p class=\"text-[13px] text-[#9a9a9a] mt-1\" data-kid=\"159\">Know exactly where clicks come from.</p></div>\n      </div>\n      <div class=\"lp-feature rounded-3xl border border-white/8 bg-[#0A0A0A] p-7 min-h-[160px] flex items-center gap-4\" data-kid=\"160\">\n        <span class=\"w-11 h-11 rounded-xl flex items-center justify-center text-[20px] text-[#6050DC] shrink-0\" style=\"background: rgba(96,80,220,0.12);\" data-kid=\"161\"><i class=\"ti ti-devices\" data-kid=\"162\"></i></span>\n        <div data-kid=\"163\"><h3 class=\"text-[16px] font-semibold text-white\" data-kid=\"164\">Device Tracking</h3><p class=\"text-[13px] text-[#9a9a9a] mt-1\" data-kid=\"165\">Mobile, desktop &amp; OS breakdowns.</p></div>\n      </div>\n      <div class=\"lp-feature rounded-3xl border border-white/8 bg-[#0A0A0A] p-7 min-h-[160px] flex items-center gap-4\" data-kid=\"166\">\n        <span class=\"w-11 h-11 rounded-xl flex items-center justify-center text-[20px] text-[#37d39b] shrink-0\" style=\"background: rgba(55,211,155,0.12);\" data-kid=\"167\"><i class=\"ti ti-users-group\" data-kid=\"168\"></i></span>\n        <div data-kid=\"169\"><h3 class=\"text-[16px] font-semibold text-white\" data-kid=\"170\">Team Collaboration</h3><p class=\"text-[13px] text-[#9a9a9a] mt-1\" data-kid=\"171\">Shared workspaces &amp; roles.</p></div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"relative z-10 py-24 border-y border-white/5\" style=\"background: linear-gradient(180deg,#050505,#080808,#050505);\" data-kid=\"172\">\n    <div class=\"pointer-events-none absolute top-1/2 right-0 -translate-y-1/2 w-[600px] h-[600px] rounded-full blur-[160px] opacity-[0.12]\" style=\"background: radial-gradient(circle,#318CE7,transparent 60%);\" data-kid=\"173\"></div>\n    <div class=\"max-w-[1280px] mx-auto px-8 grid grid-cols-1 lg:grid-cols-5 gap-12 items-center\" data-kid=\"174\">\n      \n      <div class=\"lg:col-span-2\" data-kid=\"175\">\n        <span class=\"text-[12px] uppercase tracking-[0.25em] text-[#318CE7] font-medium\" data-kid=\"176\">Analytics Engine</span>\n        <h2 class=\"text-[42px] font-bold tracking-[-0.03em] text-white leading-[1.05] mt-4\" data-kid=\"177\">Data that reads<br data-kid=\"178\">like a story.</h2>\n        <p class=\"text-[16px] text-[#A3A3A3] mt-5 max-w-[420px]\" data-kid=\"179\">Every click becomes a signal. Drill into geography, devices, and referrers with a dashboard engineered like a premium fintech product.</p>\n        <div class=\"mt-8 space-y-4 max-w-[420px]\" data-kid=\"180\">\n          <div class=\"flex items-start gap-3\" data-kid=\"181\"><span class=\"text-[#318CE7] text-[18px] mt-0.5\" data-kid=\"182\"><i class=\"ti ti-map-2\" data-kid=\"183\"></i></span><div data-kid=\"184\"><div class=\"text-[15px] font-semibold text-white\" data-kid=\"185\">Geographic insights</div><div class=\"text-[13.5px] text-[#9a9a9a]\" data-kid=\"186\">Country, region &amp; city-level click maps.</div></div></div>\n          <div class=\"flex items-start gap-3\" data-kid=\"187\"><span class=\"text-[#6050DC] text-[18px] mt-0.5\" data-kid=\"188\"><i class=\"ti ti-devices-2\" data-kid=\"189\"></i></span><div data-kid=\"190\"><div class=\"text-[15px] font-semibold text-white\" data-kid=\"191\">Device breakdowns</div><div class=\"text-[13.5px] text-[#9a9a9a]\" data-kid=\"192\">Operating system, browser &amp; form factor.</div></div></div>\n          <div class=\"flex items-start gap-3\" data-kid=\"193\"><span class=\"text-[#37d39b] text-[18px] mt-0.5\" data-kid=\"194\"><i class=\"ti ti-arrows-split\" data-kid=\"195\"></i></span><div data-kid=\"196\"><div class=\"text-[15px] font-semibold text-white\" data-kid=\"197\">Referrer analytics</div><div class=\"text-[13.5px] text-[#9a9a9a]\" data-kid=\"198\">See which channels actually convert.</div></div></div>\n        </div>\n        <a href=\"#\" class=\"inline-flex items-center gap-2 mt-9 text-[14px] font-semibold text-white px-5 py-3 rounded-xl lp-btn-glow\" style=\"background: linear-gradient(135deg,#318CE7,#2563c9);\" data-kid=\"199\">Explore the dashboard <i class=\"ti ti-arrow-right\" data-kid=\"200\"></i></a>\n      </div>\n\n      \n      <div class=\"lg:col-span-3 relative h-[480px]\" data-kid=\"201\">\n        \n        <div class=\"lp-glass absolute right-2 top-0 w-[78%] h-[300px] rounded-2xl opacity-50 blur-[1px]\" style=\"background: rgba(255,255,255,0.025);\" data-kid=\"202\"></div>\n        \n        <div class=\"lp-glass lp-float-a absolute -left-2 bottom-2 z-30 w-[260px] rounded-2xl p-4 overflow-hidden\" style=\"box-shadow: 0 30px 70px -30px rgba(96,80,220,0.6);\" data-kid=\"203\">\n          <div class=\"text-[12px] text-[#9a9a9a] mb-2 flex items-center gap-2\" data-kid=\"204\"><i class=\"ti ti-map-pin text-[#318CE7]\" data-kid=\"205\"></i> Top regions</div>\n          <div class=\"relative rounded-xl overflow-hidden h-[110px] border border-white/8\" data-kid=\"206\">\n            <img src=\"https://images.unsplash.com/photo-1768280511074-3b3effe7a139?crop=entropy&cs=srgb&fm=jpg&w=520&q=70&auto=format&fit=crop\" alt=\"Abstract dark topographic map by Resource Database on Unsplash\" decoding=\"async\" loading=\"lazy\" class=\"w-full h-full object-cover opacity-60\" data-kid=\"207\">\n            <span class=\"absolute left-[30%] top-[40%] w-2.5 h-2.5 rounded-full bg-[#318CE7] lp-pulse\" data-kid=\"208\"></span>\n            <span class=\"absolute left-[60%] top-[55%] w-2.5 h-2.5 rounded-full bg-[#37d39b] lp-pulse\" data-kid=\"209\"></span>\n            <span class=\"absolute left-[75%] top-[30%] w-2.5 h-2.5 rounded-full bg-[#6050DC] lp-pulse\" data-kid=\"210\"></span>\n          </div>\n          <div class=\"flex items-center justify-between mt-3 text-[12px]\" data-kid=\"211\"><span class=\"text-[#cfcfcf]\" data-kid=\"212\">🇺🇸 United States</span><span class=\"text-white font-semibold\" data-kid=\"213\">38%</span></div>\n          <div class=\"flex items-center justify-between mt-1.5 text-[12px]\" data-kid=\"214\"><span class=\"text-[#cfcfcf]\" data-kid=\"215\">🇩🇪 Germany</span><span class=\"text-white font-semibold\" data-kid=\"216\">19%</span></div>\n        </div>\n\n        \n        <div class=\"absolute right-0 top-10 z-20 w-[82%] rounded-2xl border border-white/10 bg-[#0A0A0A] p-5\" style=\"box-shadow: 0 50px 120px -40px rgba(0,0,0,0.9);\" data-kid=\"217\">\n          <div class=\"flex items-center justify-between mb-4\" data-kid=\"218\">\n            <div data-kid=\"219\"><div class=\"text-[12px] text-[#8a8a8a]\" data-kid=\"220\">Click trends</div><div class=\"text-[26px] font-bold text-white tracking-tight\" data-kid=\"221\">842,019</div></div>\n            <span class=\"text-[12px] px-2.5 py-1 rounded-lg text-[#37d39b] font-medium\" style=\"background: rgba(55,211,155,0.12);\" data-kid=\"222\">+18.2%</span>\n          </div>\n          <svg viewBox=\"0 0 560 200\" class=\"w-full h-[190px]\" preserveAspectRatio=\"none\" data-kid=\"223\"></svg>\n          <div class=\"grid grid-cols-3 gap-3 mt-3\" data-kid=\"234\">\n            <div data-kid=\"235\"><div class=\"text-[11px] text-[#8a8a8a]\" data-kid=\"236\">Desktop</div><div class=\"text-[15px] font-semibold text-white\" data-kid=\"237\">32%</div><div class=\"h-1.5 rounded-full bg-white/10 mt-1.5 overflow-hidden\" data-kid=\"238\"><div class=\"h-full w-[32%] rounded-full bg-[#318CE7]\" data-kid=\"239\"></div></div></div>\n            <div data-kid=\"240\"><div class=\"text-[11px] text-[#8a8a8a]\" data-kid=\"241\">Mobile</div><div class=\"text-[15px] font-semibold text-white\" data-kid=\"242\">61%</div><div class=\"h-1.5 rounded-full bg-white/10 mt-1.5 overflow-hidden\" data-kid=\"243\"><div class=\"h-full w-[61%] rounded-full bg-[#6050DC]\" data-kid=\"244\"></div></div></div>\n            <div data-kid=\"245\"><div class=\"text-[11px] text-[#8a8a8a]\" data-kid=\"246\">Tablet</div><div class=\"text-[15px] font-semibold text-white\" data-kid=\"247\">7%</div><div class=\"h-1.5 rounded-full bg-white/10 mt-1.5 overflow-hidden\" data-kid=\"248\"><div class=\"h-full w-[7%] rounded-full bg-[#37d39b]\" data-kid=\"249\"></div></div></div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"relative z-10 max-w-[1280px] mx-auto px-8 py-24\" data-kid=\"250\">\n    <div class=\"text-center max-w-[600px] mx-auto mb-14\" data-kid=\"251\">\n      <h2 class=\"text-[44px] font-bold tracking-[-0.03em] text-white\" data-kid=\"252\">Pricing that scales<br data-kid=\"253\">with your reach.</h2>\n      <p class=\"text-[16px] text-[#A3A3A3] mt-4\" data-kid=\"254\">Start free. Upgrade when your links start working harder than you do.</p>\n    </div>\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch\" data-kid=\"255\">\n      \n      <div class=\"lp-price rounded-3xl border border-white/10 bg-[#0A0A0A] p-8 flex flex-col\" data-kid=\"256\">\n        <div class=\"text-[15px] font-semibold text-white\" data-kid=\"257\">Free</div>\n        <div class=\"text-[13px] text-[#9a9a9a] mt-1\" data-kid=\"258\">For individuals getting started.</div>\n        <div class=\"mt-6 flex items-end gap-1\" data-kid=\"259\"><span class=\"text-[46px] font-extrabold text-white tracking-tight\" data-kid=\"260\">$0</span><span class=\"text-[14px] text-[#8a8a8a] mb-2\" data-kid=\"261\">/mo</span></div>\n        <a href=\"#\" class=\"mt-6 text-center text-[14px] font-semibold text-[#E5E5E5] px-5 py-3 rounded-xl border border-white/12 hover:bg-white/5 transition\" data-kid=\"262\">Get started</a>\n        <ul class=\"mt-7 space-y-3 text-[13.5px] text-[#bdbdbd]\" data-kid=\"263\">\n          <li class=\"flex items-center gap-2.5\" data-kid=\"264\"><i class=\"ti ti-check text-[#318CE7]\" data-kid=\"265\"></i> 50 short links / month</li>\n          <li class=\"flex items-center gap-2.5\" data-kid=\"266\"><i class=\"ti ti-check text-[#318CE7]\" data-kid=\"267\"></i> Basic click analytics</li>\n          <li class=\"flex items-center gap-2.5\" data-kid=\"268\"><i class=\"ti ti-check text-[#318CE7]\" data-kid=\"269\"></i> 5 QR codes</li>\n          <li class=\"flex items-center gap-2.5\" data-kid=\"270\"><i class=\"ti ti-check text-[#318CE7]\" data-kid=\"271\"></i> Community support</li>\n        </ul>\n      </div>\n\n      \n      <div class=\"relative lp-price rounded-3xl p-[1.5px] md:-translate-y-3\" style=\"background: linear-gradient(150deg,#6050DC,#318CE7);\" data-kid=\"272\">\n        <div class=\"rounded-3xl bg-[#0B0B10] p-8 h-full flex flex-col\" style=\"box-shadow: inset 0 0 40px rgba(49,140,231,0.06);\" data-kid=\"273\">\n          <div class=\"flex items-center justify-between\" data-kid=\"274\">\n            <div class=\"text-[15px] font-semibold text-white\" data-kid=\"275\">Pro</div>\n            <span class=\"text-[11px] lp-mono px-2.5 py-1 rounded-full text-white\" style=\"background: rgba(49,140,231,0.18); border:1px solid rgba(49,140,231,0.4);\" data-kid=\"276\">Most popular</span>\n          </div>\n          <div class=\"text-[13px] text-[#9a9a9a] mt-1\" data-kid=\"277\">For creators &amp; growing teams.</div>\n          <div class=\"mt-6 flex items-end gap-1\" data-kid=\"278\"><span class=\"text-[46px] font-extrabold text-white tracking-tight\" data-kid=\"279\">$24</span><span class=\"text-[14px] text-[#8a8a8a] mb-2\" data-kid=\"280\">/mo</span></div>\n          <a href=\"#\" class=\"mt-6 text-center text-[14px] font-semibold text-white px-5 py-3 rounded-xl lp-btn-glow\" style=\"background: linear-gradient(135deg,#318CE7,#2563c9);\" data-kid=\"281\">Start Pro trial</a>\n          <ul class=\"mt-7 space-y-3 text-[13.5px] text-[#dcdcdc]\" data-kid=\"282\">\n            <li class=\"flex items-center gap-2.5\" data-kid=\"283\"><i class=\"ti ti-check text-[#37d39b]\" data-kid=\"284\"></i> Unlimited short links</li>\n            <li class=\"flex items-center gap-2.5\" data-kid=\"285\"><i class=\"ti ti-check text-[#37d39b]\" data-kid=\"286\"></i> Real-time advanced analytics</li>\n            <li class=\"flex items-center gap-2.5\" data-kid=\"287\"><i class=\"ti ti-check text-[#37d39b]\" data-kid=\"288\"></i> Custom branded domains</li>\n            <li class=\"flex items-center gap-2.5\" data-kid=\"289\"><i class=\"ti ti-check text-[#37d39b]\" data-kid=\"290\"></i> Unlimited dynamic QR codes</li>\n            <li class=\"flex items-center gap-2.5\" data-kid=\"291\"><i class=\"ti ti-check text-[#37d39b]\" data-kid=\"292\"></i> Team workspace (5 seats)</li>\n          </ul>\n        </div>\n      </div>\n\n      \n      <div class=\"lp-price rounded-3xl border border-white/10 bg-[#0A0A0A] p-8 flex flex-col\" data-kid=\"293\">\n        <div class=\"text-[15px] font-semibold text-white\" data-kid=\"294\">Enterprise</div>\n        <div class=\"text-[13px] text-[#9a9a9a] mt-1\" data-kid=\"295\">For organizations at scale.</div>\n        <div class=\"mt-6 flex items-end gap-1\" data-kid=\"296\"><span class=\"text-[46px] font-extrabold text-white tracking-tight\" data-kid=\"297\">Custom</span></div>\n        <a href=\"#\" class=\"mt-6 text-center text-[14px] font-semibold text-[#E5E5E5] px-5 py-3 rounded-xl border border-white/12 hover:bg-white/5 transition\" data-kid=\"298\">Contact sales</a>\n        <ul class=\"mt-7 space-y-3 text-[13.5px] text-[#bdbdbd]\" data-kid=\"299\">\n          <li class=\"flex items-center gap-2.5\" data-kid=\"300\"><i class=\"ti ti-check text-[#6050DC]\" data-kid=\"301\"></i> Everything in Pro</li>\n          <li class=\"flex items-center gap-2.5\" data-kid=\"302\"><i class=\"ti ti-check text-[#6050DC]\" data-kid=\"303\"></i> SSO &amp; SCIM provisioning</li>\n          <li class=\"flex items-center gap-2.5\" data-kid=\"304\"><i class=\"ti ti-check text-[#6050DC]\" data-kid=\"305\"></i> Dedicated success manager</li>\n          <li class=\"flex items-center gap-2.5\" data-kid=\"306\"><i class=\"ti ti-check text-[#6050DC]\" data-kid=\"307\"></i> 99.99% uptime SLA</li>\n          <li class=\"flex items-center gap-2.5\" data-kid=\"308\"><i class=\"ti ti-check text-[#6050DC]\" data-kid=\"309\"></i> Audit logs &amp; SOC 2</li>\n        </ul>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"relative z-10 px-8 py-28\" data-kid=\"310\">\n    <div class=\"pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] rounded-full blur-[150px] opacity-[0.25]\" style=\"background: radial-gradient(circle,#6050DC,transparent 60%);\" data-kid=\"311\"></div>\n    <div class=\"relative max-w-[820px] mx-auto text-center lp-dotgrid rounded-[32px] border border-white/8 py-20 px-8\" style=\"background: rgba(10,10,12,0.5);\" data-kid=\"312\">\n      <h2 class=\"text-[58px] leading-[1.02] font-extrabold tracking-[-0.04em] text-white\" data-kid=\"313\">Turn every link into<br data-kid=\"314\">actionable data.</h2>\n      <p class=\"text-[18px] text-[#A3A3A3] mt-6 max-w-[520px] mx-auto\" data-kid=\"315\">Join two million teams using Linkforge to shorten, brand, and understand every link they share.</p>\n      <div class=\"flex items-center justify-center gap-4 mt-10\" data-kid=\"316\">\n        <a href=\"#\" class=\"text-[15px] font-semibold text-white px-7 py-4 rounded-xl lp-btn-glow flex items-center gap-2\" style=\"background: linear-gradient(135deg,#318CE7,#2563c9);\" data-kid=\"317\">Get Started Free <i class=\"ti ti-arrow-right\" data-kid=\"318\"></i></a>\n        <a href=\"#\" class=\"text-[15px] font-semibold text-[#E5E5E5] px-7 py-4 rounded-xl border border-white/12 hover:bg-white/5 transition flex items-center gap-2\" data-kid=\"319\"><i class=\"ti ti-player-play\" data-kid=\"320\"></i> View Demo</a>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"relative z-10 border-t border-white/8 bg-[#070707]\" data-kid=\"321\">\n    <div class=\"max-w-[1280px] mx-auto px-8 py-14 grid grid-cols-2 md:grid-cols-5 gap-8\" data-kid=\"322\">\n      <div class=\"col-span-2\" data-kid=\"323\">\n        <div class=\"flex items-center gap-2.5\" data-kid=\"324\">\n          <div class=\"w-8 h-8 rounded-lg flex items-center justify-center text-[18px] text-white\" style=\"background: linear-gradient(135deg,#318CE7,#6050DC);\" data-kid=\"325\"><i class=\"ti ti-link\" data-kid=\"326\"></i></div>\n          <span class=\"text-[17px] font-bold tracking-tight text-white\" data-kid=\"327\">Linkforge</span>\n        </div>\n        <p class=\"text-[13.5px] text-[#8a8a8a] mt-4 max-w-[280px]\" data-kid=\"328\">The intelligent link platform for teams that measure everything.</p>\n        <div class=\"flex items-center gap-3 mt-5 text-[#9a9a9a] text-[18px]\" data-kid=\"329\">\n          <a href=\"#\" class=\"lp-link\" data-kid=\"330\"><i class=\"ti ti-brand-x\" data-kid=\"331\"></i></a>\n          <a href=\"#\" class=\"lp-link\" data-kid=\"332\"><i class=\"ti ti-brand-github\" data-kid=\"333\"></i></a>\n          <a href=\"#\" class=\"lp-link\" data-kid=\"334\"><i class=\"ti ti-brand-linkedin\" data-kid=\"335\"></i></a>\n        </div>\n      </div>\n      <div data-kid=\"336\"><div class=\"text-[13px] font-semibold text-white mb-3\" data-kid=\"337\">Product</div><ul class=\"space-y-2.5 text-[13px] text-[#8a8a8a]\" data-kid=\"338\"><li data-kid=\"339\"><a href=\"#\" class=\"lp-link\" data-kid=\"340\">Features</a></li><li data-kid=\"341\"><a href=\"#\" class=\"lp-link\" data-kid=\"342\">Analytics</a></li><li data-kid=\"343\"><a href=\"#\" class=\"lp-link\" data-kid=\"344\">QR Codes</a></li><li data-kid=\"345\"><a href=\"#\" class=\"lp-link